GT: {gt_ans}\")\n            print(f\"[DEBUG] Model Out (First 100 chars): {completion_text_norm[:100]}...\")\n            DEBUG_ONCE = False\n\n        # --- PART 1: FORMAT CHECK (0.5 Points) ---\n        format_score = 0.0\n        extracted_model_answer = None\n\n        match = re.search(xml_pattern, completion_text_norm, flags=re.DOTALL | re.IGNORECASE)\n\n        if match:\n            reasoning_content = match.group(1).strip()\n            answer_content = match.group(2).strip()\n\n            # Word count constraint (Reasoning length)\n            word_count = len(reasoning_content.split())\n            if 25 <= word_count <= 600:\n                format_score = 0.5\n                extracted_model_answer = answer_content\n            else:\n                format_score = 0.0 # Format correct, but length constraint failed\n        else:\n            format_score = 0.0\n\n        # --- PART 2: ACCURACY CHECK (0.5 Points) ---\n        accuracy_score = 0.0\n\n        if extracted_model_answer and gt_ans:\n            # Normalize Model Output\n            # Lowercase and remove common trailing punctuation (.,;!)\n            model_val = extracted_model_answer.lower().strip().rstrip(\".,;!\")\n            \n            # Normalize Ground Truth\n            gt_val = str(gt_ans).strip()\n            gt_val_clean = re.sub(r'\\.$', '', gt_val).lower()\n\n            try:\n                # --- Domain Logic ---\n\n                # Group 1: Numbers, Bool, Entailment (W6, PZ1, PZ2, CS4)\n                if dom in ['W6', 'PZ1', 'PZ2', 'CS4']:\n                    # (?<!-) is a Negative Lookbehind. \n                    # It ensures the match is NOT preceded by a hyphen.\n                    # This prevents \"entailment\" from matching \"not-entailment\".\n                    strict_regex = rf\"(?<!-)\\b{re.escape(gt_val_clean)}\\b\"\n                    \n                    if re.search(strict_regex, model_val):\n                        accuracy_score = 0.5\n\n                # Group 2: Composite Logic (Number_Text) (FP1, FP2, CS1, CS2, CS3)\n                elif dom in ['FP1', 'FP2', 'CS1', 'CS2', 'CS3']:\n                    target_num = \"\"\n                    target_text = \"\"\n                    \n                    # Split safely\n                    if '_' in gt_val_clean:\n                        parts = gt_val_clean.split('_', 1)\n                        target_num = parts[0].strip()\n                        target_text = parts[1].strip()\n                    else:\n                        target_text = gt_val_clean\n\n                    # Check 1: Number (Strict Match)\n                    num_match = False\n                    if target_num and re.search(rf\"\\b{re.escape(target_num)}\\b\", model_val):\n                        num_match = True\n                    \n                    # Check 2: Text Match\n                    text_match = False\n                    if target_text:\n                        # Logic: If text is a sentence (multiple words), allow loose matching.\n                        # If text is a single word (e.g. \"domains\"), enforce strict boundary to avoid substring matches.\n                        if len(target_text.split()) > 1:\n                             if target_text in model_val: text_match = True\n                        else:\n                             if re.search(rf\"\\b{re.escape(target_text)}\\b\", model_val): text_match = True\n\n                    if num_match or text_match:\n                        accuracy_score = 0.5\n\n                # Fallback for unknown domains\n                else:\n                    if re.search(rf\"\\b{re.escape(gt_val_clean)}\\b\", model_val):\n                        accuracy_score = 0.5\n            \n            except Exception as e:\n                # Fail gracefully if regex errors occur\n                accuracy_score = 0.0 \n\n        rewards.append(format_score + accuracy_score)\n\n    return rewards","metadata":{"trusted":true