_score = 0.4\n        else:\n            score = 0.0\n            if completion_text_norm.lower().startswith('<reasoning>'):\n                score += 0.1\n                pos_reasoning_close = completion_text_norm.lower().find('</reasoning>')\n                if pos_reasoning_close > 0:\n                    score += 0.1\n                    pos_answer_open = completion_text_norm.lower().find('<answer>', pos_reasoning_close)\n                    if pos_answer_open > pos_reasoning_close:\n                        score += 0.1\n                        if completion_text_norm.lower().endswith('</answer>') or completion_text_norm.lower().endswith('</answer><end_of_turn>'):\n                            score += 0.1\n            format_score = score\n            \n        # --- Extract content for reasoning and accuracy checks ---\n        reasoning_content = None\n        extracted_model_answer = None\n        match = re.search(xml_pattern, completion_text_norm, flags=re.DOTALL | re.IGNORECASE)\n        if match:\n            reasoning_content = match.group(1).strip()\n            extracted_model_answer = match.group(2).strip()\n\n        # --- PART 2: REASONING CONTENT CHECK (Max 0.25) ---\n        if reasoning_content:\n            word_count = len(reasoning_content.split())\n            if 25 <= word_count <= 600:\n                reasoning_length_score = 0.25\n\n        # --- PART 3: ACCURACY CHECK (Max 0.35) ---\n        if extracted_model_answer and gt_ans:\n            model_val = extracted_model_answer.lower().strip().rstrip(\".,;!\")\n            gt_val = str(gt_ans).strip()\n            gt_val_clean = re.sub(r'\\.$', '', gt_val).lower()\n\n            try:\n                # Domain-specific logic for accuracy\n                is_correct = False\n                if dom in ['W6', 'PZ1', 'PZ2', 'CS4']:\n                    # Use exact match for these domains to avoid partial matches like \"entailment\" in \"not-entailment\"\n                    if model_val == gt_val_clean:\n                        is_correct = True\n                elif dom in ['FP1', 'FP2', 'CS1', 'CS2', 'CS3']:\n                    target_num, target_text = \"\", \"\"\n                    if '_' in gt_val_clean:\n                        parts = gt_val_clean.split('_', 1)\n                        target_num, target_text = parts[0].strip(), parts[1].strip()\n                    else:\n                        target_text = gt_val_clean\n                    \n                    num_match = target_num and re.search(rf\"\\b{re.escape(target_num)}\\b\", model_val)\n                    text_match = False\n                    if target_text:\n                        if len(target_text.split()) > 1:\n                            if target_text in model_val: text_match = True\n                        else:\n                            if re.search(rf\"\\b{re.escape(target_text)}\\b\", model_val): text_match = True\n                    \n                    if num_match or text_match:\n                        is_correct = True\n                else: # Fallback for other domains\n                    if re.search(rf\"\\b{re.escape(gt_val_clean)}\\b\", model_val):\n                        is_correct = True\n                \n                if is_correct:\n                    accuracy_score = 0.35\n            \n            except Exception as e:\n                accuracy_score = 0.0 \n\n        # --- Final Reward ---\n        rewards.append(format_score + reasoning_length_score + accuracy_score)\n\n    return rewards","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-07T00:16:35.082893Z","iopub.execute_input":"2026-01-07T00:16:35.083197Z","iopub.status.idle":"2026-01-07T00:16:35.094585Z","shell.execute_reply.started":"2026-01-07T00:16:35.083174Z","shell.execute_reply":"2026-01-07T00:16:35.093663Z"}},"outputs":[],"execution_count":105},{"cell_type":"code","source":"# Ckpt saving\ncheckpointing_options = ocp.CheckpointManagerOptions(\n    save_interval_