l = qwix.apply_lora_to_model(\n      base_model, lora_provider, **model_input\n  )\n\n  with mesh:\n    state = nnx.state(lora_model)\n    pspecs = nnx.get_partition_spec(state)\n    sharded_state = jax.lax.with_sharding_constraint(state, pspecs)\n    nnx.update(lora_model, sharded_state)\n\n  return lora_model","metadata":{"_uuid":"f59dfe7e-ee7d-463b-90fb-45f0c9c0af59","_cell_guid":"6b1b0342-4182-4573-a2be-5178b72cb90f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T18:44:06.742279Z","iopub.execute_input":"2026-01-10T18:44:06.742626Z","iopub.status.idle":"2026-01-10T18:44:06.749260Z","shell.execute_reply.started":"2026-01-10T18:44:06.742607Z","shell.execute_reply":"2026-01-10T18:44:06.748267Z"}},"outputs":[],"execution_count":61},{"cell_type":"code","source":"base_ref, _, _ = get_gemma_ref_model(os.path.join(SFT_INTERMEDIATE_CKPT_DIR, \"state\"))\nref_model = get_lora_model(base_ref, mesh)\n\n# 3. Sync Weights: Load the SFT checkpoint into this new reference model\ncheckpointer = ocp.StandardCheckpointer()\nabs_params = jax.tree.map(\n    lambda x: jax.ShapeDtypeStruct(x.shape, x.dtype),\n    nnx.state(ref_model, nnx.LoRAParam),\n)\ntrained_lora_params = checkpointer.restore(trained_ckpt_path, target=abs_params)\n\n# Update the reference model state\nnnx.update(ref_model, trained_lora_params)\n\nprint(\"✅ Reference model loaded as a separate object.\")","metadata":{"_uuid":"622d775e-ab30-494f-8d84-05577f86e8b8","_cell_guid":"3d09cb09-4fa9-403f-8579-f318586f412c","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T18:44:09.286304Z","iopub.execute_input":"2026-01-10T18:44:09.286608Z","iopub.status.idle":"2026-01-10T18:44:30.285365Z","shell.execute_reply.started":"2026-01-10T18:44:09.286590Z","shell.execute_reply":"2026-01-10T18:44:30.284125Z"}},"outputs":[{"name":"stderr","text":"/usr/local/lib/python3.12/site-packages/orbax/checkpoint/_src/s