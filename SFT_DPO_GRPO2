et_df()\n\ndata_df.head()","metadata":{"_uuid":"56a8fa8c-3e4e-4f19-bba5-0487e4382c5d","_cell_guid":"9a327823-6303-49f8-a737-ac7ff02ea776","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"eos_token = \"<end_of_turn>\"\n\ndef ensure_eos(text):\n    text = str(text)\n    # 1. Strip whitespace from the right side to handle \"text<end_of_turn>  \"\n    # 2. Check if it ends with the token\n    if not text.rstrip().endswith(eos_token):\n        return text + eos_token\n    return text\n\ndata_df['CHOSEN'] = data_df['CHOSEN'].apply(ensure_eos)\ndata_df['REJECTED'] = data_df['REJECTED'].apply(ensure_eos)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#data_df = data_df.head(1000)","metadata":{"_uuid":"bd319599-1ad3-4677-9b99-737db1767db2","_cell_guid":"1b31b825-cec3-4333-9dd7-f944990d1396","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"data_df.shape","metadata":{"_uuid":"4701ae39-4dc5-4cc0-a7b7-ace15c046328","_cell_guid":"cdc06afe-c3ab-46d8-b9c2-e6619b37574e","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import random\nrandom_integer = random.randint(0, len(data_df))\nprint(data_df['prompt'][random_integer])\nprint(\"=\"*60)\nprint(data_df['CHOSEN'][random_integer])\nprint(\"=\"*60)\nprint(data_df['REJECTED'][random_integer])","metadata":{"_uuid":"1e2669ef-7252-44fe-9b68-fa2b5f463122","_cell_guid":"80d52da8-a82d-4ca8-80a2-cee2237f7efc","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_split, test_split = train_test_split(\n    data_df,\n    test_size=0.05,\n    stratify=data_df['Dataset'], # Maintain distribution\n    random_state=42,\n    shuffle=True\n)\n\ntrain_df = train_split.sample(frac=1, random_state=42).reset_index(drop=True)\ntest_df = test_split.sample(frac=1, random_state=42).reset_index(drop=True)\n\nprint(f\"Train Data shape: {train_split.shape}\\nTest Data shape: {test_split.shape}\")","metadata":{"_uuid":"8a734661-7a04-4592-92c4-6fe336940fc3","_cell_guid":"9ad89d22-66eb-4a4a-a030-272fe64ef2fd","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Hyperparameters","metadata":{"_uuid":"6f34337b-bb2c-4da1-98a6-31644b846294","_cell_guid":"a298b23d-7c36-4697-a5ce-f97bebe6939b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# ====== Data ======\nTRAIN_DATA_DIR = \"./data/train\"\nTEST_DATA_DIR = \"./data/test\"\nTRAIN_FRACTION = 1.0\n\n# ====== LoRA ======\nRANK = 64\nALPHA = 64.0\n\n# ====== Sharding ======\nMESH = [(8, 1), (\"fsdp\", \"tp\")]\n\n# ====== DPO ======\nMAX_PROMPT_LENGTH = 1024\nMAX_RESPONSE_LENGTH = 1024\nTEMPERATURE = 0.9\nTOP_P = 1.0\nTOP_K = 50\n# The coefficient for the KL divergence penalty (𝛽) in the DPO loss function.\n# Important to keep a high enough value for this, otherwise, the KL divergence\n# can increase unchecked.\nBETA = 0.2\n\n# ====== Training ======\nGRADIENT_ACCUMULATION_STEPS = 8\nTRAIN_MICRO_BATCH_SIZE = 4\n\nEVAL_EVERY_N_STEPS = 100\nNUM_EPOCHS = 1\n\n# === AdamW, warmup, cosine scheduler ===\nLEARNING_RATE = 3e-6\nB1 = 0.9\nB2 = 0.99\nWEIGHT_DECAY = 0.1\n\nEFFECTIVE_BATCH_SIZE = TRAIN_MICRO_BATCH_SIZE * GRADIENT_ACCUMULATION_STEPS\nSTEPS_PER_EPOCH = len(train_df) // EFFECTIVE_BATCH_SIZE\nMAX_STEPS = STEPS_PER_EPOCH * NUM_EPOCHS\nWARMUP_STEPS = int(0.1 * MAX_STEPS)\n\n\n# == Grad clipping ==\n# Grad clipping to prevent large gradients. Found this\n# important to keep KL divergence in check.\nMAX_GRAD_NORM = 0.1\n\n# Checkpoint saving (DPO)\nDPO_INTERMEDIATE_CKPT_DIR = \"/tmp/content/dpo/intermediate_ckpt/\"\nDPO_CKPT_DIR = \"/tmp/content/dpo/ckpts/\"\nSAVE_INTERVAL_STEPS = 500\nMAX_TO_KEEP = 4\n\n# ====== Inference ======\nGENERATION_CONFIGS = {\n    # greedy search\n    \"greedy\": {\"temperature\": 1e-4, \"top_k\": 1, \"top_p\": 1.0},\n    # some randomness\n    \"standard\": {\"temperature\": 0.7, \"top_k\": 50, \"top_p\": 0.95},\n    # liberal\n    \"liberal\": {\"temperature\": 0.85, \"top_k\": 2000, \"top_p\": 1.0},\n}","metadata":{"_uuid":"e417b8f8-8f17-410b-b9d5-9c2becd33c18","_cell_guid":"90a84dd9-60a8-4831-84f7-62bbabb385a8","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"print(f\"Training on {len(train_df)} samples. Max Steps: {MAX_STEPS}\")","metadata":{"_uuid":"6cb20f1c-3f95-49a1-8838-1b0a54320163","_cell_guid":"e58633e3-6a6a-4853-b6f9-7e37a3bdea45","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Grain Dataset","metadata":{"_uuid":"a2880766-6735-4dde-b4d2-143e983d7fae","_cell_guid":"c0b3a9ea-8911-433d-9281-71d7a0efc90b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"BASE_SYSTEM_PROMPT  = \"\"\"<start_of_turn>user \nYou are a meticulous AI expert. Your task is to solve a problem by first showing your work and then stating the final answer.\n\nINSTRUCTIONS:\n1.  **Reasoning:** Break down the problem and explain your thought process. Enclose this entire thought process in between <reasoning> and </reasoning>.\n2.  **Answer:** State only the final, conclusive answer. Enclose it in between <answer> and </answer>.\n\nTASK:\n'''\n{task}\n'''\n<end_of_turn>\n<start_of_turn>model\n\"\"\"","metadata":{"_uuid":"d7d75fbc-140f-4717-9305-11d4924866d8","_cell_guid":"eeeec3e0-48e2-4295-9ee4-a63e84919ad5","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Adjust the val_ds_small = sample size in below later","metadata":{"_uuid":"9682814b-b561-4200-892e-785d6cb67d43","_cell_guid":"39ece4d4-3b58-4ffe-9e2d-c7251df9785e","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def create_grain_dataset(dataframe):\n    \"\"\"Converts a Pandas DataFrame to a grain MapDataset for DPO.\"\"\"\n    \n    # Convert DF to list of dicts\n    data_source = dataframe.to_dict('records')\n    \n    # Define mapping function to format keys required by DPOTrainer\n    def format_dpo_entry(row):\n        # Construct the full prompt\n        full_prompt = BASE_SYSTEM_PROMPT.format(task=row['prompt'])\n        \n        return {\n            \"prompts\": full_prompt,\n            \"chosen_responses\": str(row['CHOSEN']),\n            \"rejected_responses\": str(row['REJECTED'])\n        }\n\n    dataset = grain.MapDataset.source(data_source).map(format_dpo_entry)\n    return dataset\n\n# Create Datasets\ntrain_ds = create_grain_dataset(train_df).batch(TRAIN_MICRO_BATCH_SIZE).repeat(NUM_EPOCHS)\n\n# Create Validation Dataset [Full]\nval_ds = create_grain_dataset(test_df).batch(TRAIN_MICRO_BATCH_SIZE)\n\n# Create Validation Dataset (taking a small slice for speed) as we will be passing it to the TRAINER loop\nval_ds_small = create_grain_dataset(\n    test_df.sample(n=20 * TRAIN_MICRO_BATCH_SIZE, random_state=42) \n).batch(TRAIN_MICRO_BATCH_SIZE)","metadata":{"_uuid":"af93fc12-2887-47ab-bf0f-b39bb89f2560","_cell_guid":"04dc5ebb-3149-4292-8796-2aa644a230ea","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"train_ds[0]","metadata":{"_uuid":"71fd733f-4f40-46ca-8b65-b0b583c37998","_cell_guid":"c63194a4-9556-421d-918f-1efd5ac04d6d","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Model Setup","metadata":{"_uuid":"7fc80ed4-ab66-4320-a7a2-6eb9070f47c7","_cell_guid":"09826a42-c20c-491f-bf3d-b6d11bc92e80","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"model_path = {\n    \"gemma2\": \"google/gemma-2/flax/\",\n}\nmodel_family = \"gemma2\"\nmodel_version = \"gemma2-2b-it\"\nprint(f\"{model_path[model_family]}{model_version}\")\n\nkaggle_ckpt_path = kagglehub.model_download(\n    f\"{model_path[model_family]}{model_version}\"\n)","metadata":{"_uuid":"6254bb51-9737-48b8-a42c-3eea5e5dbc09","_cell_guid":"7c18b455-7311-42e9-a613-a273dd69c29c","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"_uuid":"e56b83c3-73ff-4a99-9619-46a26e006cfd","_cell_guid":"19b27687-6c68-4d8d-a71e-c164aad77a79","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def get_gemma_ref_model(ckpt_path):\n  mesh = jax.make_mesh(*MESH)\n  model_config = gemma_lib.ModelConfig.gemma2_2b()\n  abs_gemma: nnx.Module = nnx.eval_shape(\n      lambda: gemma_lib.Transformer(model_config, rngs=nnx.Rngs(params=0))\n  )\n  abs_state = nnx.state(abs_gemma)\n  abs_state = jax.tree.map(\n      lambda a, s: jax.ShapeDtypeStruct(a.shape, jnp.bfloat16, sharding=s),\n      abs_state,\n      nnx.get_named_sharding(abs_state, mesh),\n  )\n  checkpointer = ocp.StandardCheckpointer()\n  restored_params = checkpointer.restore(ckpt_path, target=abs_state)\n\n  graph_def, _ = nnx.split(abs_gemma)\n  gemma = nnx.merge(graph_def, restored_params)\n  return gemma, mesh, model_config\n\n\ndef get_lora_model(base_model, mesh):\n  lora_provider = qwix.LoraProvider(\n      module_path=(\n          \".*q_einsum|.*kv_einsum|.*gate_proj|.*down_proj|.*up_proj|\"\n          \".*attn_vec_einsum\"\n      ),\n      rank=RANK,\n      alpha=ALPHA,\n  )\n\n  model_input = base_model.get_model_input()\n  lora_model = qwix.apply_lora_to_model(\n      base_model, lora_provider, **model_input\n  )\n\n  with mesh:\n    state = nnx.state(lora_model)\n    pspecs = nnx.get_partition_spec(state)\n    sharded_state = jax.lax.with_sharding_constraint(state, pspecs)\n    nnx.update(lora_model, sharded_state)\n\n  return lora_model","metadata":{"_uuid":"4cfd72d3-335a-49a7-9c90-b7f0cc117a5b","_cell_guid":"7d0187be-d9b2-4d04-9fce-acca57a35c23","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"base_ref, _, _ = get_gemma_ref_model(os.path.join(SFT_INTERMEDIATE_CKPT_DIR, \"state\"))\nref_model = get_lora_model(base_ref, mesh)\n\n# 3. Sync Weights: Load the SFT checkpoint into this new reference model\ncheckpointer = ocp.StandardCheckpointer()\nabs_params = jax.tree.map(\n    lambda x: jax.ShapeDtypeStruct(x.shape, x.dtype),\n    nnx.state(ref_model, nnx.LoRAParam),\n)\ntrained_lora_params = checkpointer.restore(trained_ckpt_path, target=abs_params)\n\n# Update the reference model state\nnnx.update(ref_model, trained_lora_params)\n\nprint(\"✅ Reference model loaded as a separate object.\")","metadata":{"_uuid":"be1336b8-81d3-42d6-9d8d-08bced77d95f","_cell_guid":"b7a51234-a357-4b36-9779-e4dd2afd598f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# The SFT-trained model is already loaded into the `lora_policy` variable.\n# We'll use this as the reference model for DPO. The `DPOTrainer` will use\n# this for the reference policy and also as the starting point for the trainable policy model.\n#print(\"Using SFT-trained model as the reference and initial policy for DPO.\")\n#ref_model = lora_policy\n\n# The tokenizer, mesh, and model_config are already loaded from the SFT stage,\n# so we don't need to reload them.","metadata":{"_uuid":"344de68c-9d3e-4ff1-8cb5-e35c065a08ad","_cell_guid":"23aeb4e1-7bd8-4326-9eec-42ba768a9998","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. DPO config","metadata":{"_uuid":"c4e3cf69-a847-4133-992e-61dcc60b9807","_cell_guid":"875e0536-31ca-451d-bc45-addb4adb5548","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# Ckpt saving\ncheckpointing_options = ocp.CheckpointManagerOptions(\n    save_interval_steps=SAVE_INTERVAL_STEPS, max_to_keep=MAX_TO_KEEP\n)\n\n# Metrics logger\nmetrics_logging_options = metrics_logger.MetricsLoggerOptions(\n    log_dir=\"/tmp/content/tmp/tensorboard/DPO\", flush_every_n_steps=20\n)","metadata":{"_uuid":"b65fb3d6-ebd9-488d-9c9d-1f2eb5b05eaa","_cell_guid":"b48c2807-b8c7-4a92-b915-527f987c9d4e","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Optimizer, learning rate scheduler, gradient clipping\noptimizer = optax.adamw(\n    learning_rate=optax.schedules.warmup_cosine_decay_schedule(\n        init_value=1e-6,\n        peak_value=LEARNING_RATE,\n        warmup_steps=WARMUP_STEPS,\n        decay_steps=int(MAX_STEPS),\n        end_value=LEARNING_RATE*0.1,\n    ),\n    b1=B1,\n    b2=B2,\n    weight_decay=WEIGHT_DECAY,\n)\nif MAX_GRAD_NORM is not None:\n  optimizer = optax.chain(\n      optax.clip_by_global_norm(max_norm=MAX_GRAD_NORM),\n      optimizer,\n  )","metadata":{"_uuid":"aaa23303-73e3-4086-ba62-411b27790808","_cell_guid":"337ee685-b8e1-4e3c-aa39-2778fb6c66d1","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# DPO training config\ndpo_config = DPOTrainingConfig(\n    beta=BETA,\n    eval_every_n_steps=EVAL_EVERY_N_STEPS,\n    max_steps=MAX_STEPS,\n    gradient_accumulation_steps=GRADIENT_ACCUMULATION_STEPS,\n    max_prompt_length=MAX_PROMPT_LENGTH,\n    max_response_length=MAX_RESPONSE_LENGTH,\n    metrics_logging_options=metrics_logging_options,\n    checkpoint_root_directory=DPO_CKPT_DIR,\n    checkpointing_options=checkpointing_options,\n)","metadata":{"_uuid":"ec27a988-270a-4f55-a889-4e2e73d15ba1","_cell_guid":"421dbb97-2652-4fc4-a336-813a3f2aba81","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# DPO Trainer\ndpo_trainer = DPOTrainer(\n    model=lora_policy,\n    ref_model=ref_model,\n    optimizer=optimizer,\n    training_config=dpo_config,\n    tokenizer=tokenizer,\n)","metadata":{"_uuid":"bd2fab86-6098-44c9-8c99-6e5cf664df65","_cell_guid":"120831b3-e668-483b-98d2-3603501b72d5","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 2. Pre Training","metadata":{"_uuid":"9352d2d2-5ceb-48e7-8290-fc8af6b10268","_cell_guid":"5d1fd501-d5d5-41b8-ad8e-16e821361483","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def generate(question, sampler, temperature=0.7, top_k=50, top_p=0.95, seed=None):\n  if isinstance(question, str):\n    BASE_SYSTEM_PROMPT.format(task = question)\n    input_batch = [\n        BASE_SYSTEM_PROMPT.format(task = question),\n    ]\n  else:\n    input_batch = [\n        BASE_SYSTEM_PROMPT.format(          \n            task=q,\n        )\n        for q in question\n    ]\n\n  out_data = sampler(\n      input_strings=input_batch,\n      max_generation_steps=768,\n      temperature=temperature,\n      top_k=top_k,\n      top_p=top_p,\n      echo=False,\n      seed=seed if seed is not None else None,\n      eos_tokens=[1,106],\n  )\n\n  output = out_data.text\n  if isinstance(question, str):\n    return output[0]\n  return output","metadata":{"_uuid":"9576601d-abc4-4275-8e37-3e988d54053a","_cell_guid":"bbef21c9-cd0b-409d-998f-5ca6f779312d","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"sampler = 