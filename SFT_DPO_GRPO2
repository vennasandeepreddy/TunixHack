s_hidden":false}}},{"cell_type":"code","source":"model_path = {\n    \"gemma2\": \"google/gemma-2/flax/\",\n}\nmodel_family = \"gemma2\"\nmodel_version = \"gemma2-2b-it\"\nprint(f\"{model_path[model_family]}{model_version}\")\n\nkaggle_ckpt_path = kagglehub.model_download(\n    f\"{model_path[model_family]}{model_version}\"\n)","metadata":{"_uuid":"3049f2d0-7297-4400-9aea-e3bdf374250f","_cell_guid":"d1e15a9e-01fb-487c-ac63-a96e5be01c6f","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-07T23:26:21.294899Z","iopub.execute_input":"2026-01-07T23:26:21.295230Z","iopub.status.idle":"2026-01-07T23:26:22.007958Z","shell.execute_reply.started":"2026-01-07T23:26:21.295203Z","shell.execute_reply":"2026-01-07T23:26:22.006947Z"},"jupyter":{"outputs_hidden":false}},"outputs":[{"name":"stdout","text":"google/gemma-2/flax/gemma2-2b-it\n","output_type":"stream"}],"execution_count":32},{"cell_type":"code","source":"def get_gemma_ref_model(ckpt_path):\n  grpo_mesh = jax.make_mesh(*GRPO_MESH)\n  model_config = gemma_lib.ModelConfig.gemma2_2b()\n  abs_gemma: nnx.Module = nnx.eval_shape(\n      lambda: gemma_lib.Transformer(model_config, rngs=nnx.Rngs(params=0))\n  )\n  abs_state = nnx.state(abs_gemma)\n  abs_state = jax.tree.map(\n      lambda a, s: jax.ShapeDtypeStruct(a.shape, jnp.bfloat16, sharding=s),\n      abs_state,\n      nnx.get_named_sharding(abs_state, grpo_mesh),\n  )\n  checkpointer = ocp.StandardCheckpointer()\n  restored_params = checkpointer.restore(ckpt_path, target=abs_state)\n\n  graph_def, _ = nnx.split(abs_gemma)\n  gemma = nnx.merge(graph_def, restored_params)\n  return gemma, grpo_mesh, model_config\n\n\ndef get_lora_model(base_model, grpo_mesh):\n  lora_provider = qwix.LoraProvider(\n      module_path=(\n          \".*q_einsum|.*kv_einsum|.*gate_proj|.*down_proj|.*up_proj|\"\n          \".*attn_vec_einsum\"\n      ),\n      rank=RANK,\n      alpha=ALPHA,\n  )\n\n  model_input = base_model.get_model_input()\n  lora_model = qwix.apply_lora_to_model(\n      base_model, lora_provider, **model_input\n  )\n\n  with grpo_mesh:\n    state = nnx.state(lora_model)\n    pspecs = nnx.get_partition_spec(state)\n    sharded_state = jax.lax.with_sharding_constraint(state, pspecs)\n    nnx.update(lora_model, sharded_state)\n\n  return lora_model","metadata":{"_uuid":"9e7d09de-b820-44ef-8d88-3e63c480e1d0","_cell_guid":"c18d7231-d80a-4e08-9d25-69e78d537b31","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"trained_ckpt_path","metadata":{"_uuid":"fa93ea76-c8dc-472c-87b0-c7160e98d859","_cell_guid":"e3742675-e4f4-4860-ab1d-7f1dd4c707a8","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 1. Initialize Base Model (Load from disk ONCE)\nprint(\"Loading Base Model from disk...\")\nbase_model_ref, grpo_mesh, model_config = get_gemma_ref_model(\n    os.path.join(SFT_INTERMEDIATE_CKPT_DIR, \"state\")\n)\n\n# 2. Create a copy for the Policy Model (In-memory clone)\n# This avoids reading from disk again. \n# We split the model into graph definition and state, then merge them back to create a new independent object.\nprint(\"Cloning Base Model for Policy...\")\ngraph_def, params = nnx.split(base_model_ref)\nbase_model_policy = nnx.merge(graph_def, params)\n\n# 3. Apply LoRA to Reference Model\nprint(\"Applying LoRA to Reference Model...\")\nref_model = get_lora_model(base_model_ref, grpo_mesh=grpo_mesh)\n\n# 4. Apply LoRA to Policy Model\nprint(\"Applying LoRA to Policy Model...\")\nlora_policy = get_lora_model(base_model_policy, grpo_mesh=grpo_mesh)\n\nprint(\"✅ Base models initialized on GRPO Mesh.\")\n\n# 5. Load DPO Weights into BOTH models\ndpo_checkpoint_root = \"/tmp/content/dpo/ckpts\"\n\nif os.path.exists(dpo_checkpoint_root):\n    dpo_steps = [int(d) for d in os.listdir(dpo_checkpoint_root) if d.isdigit()]\n    if dpo_steps:\n        latest_dpo_step = max(dpo_steps)\n        trained_ckpt_path = os.path.join(dpo_checkpoint_root, str(latest_dpo_step), \"model_params\")\n\n        print(f\"Loading DPO checkpoint from: {trained_ckpt_path}\")\n        checkpointer = ocp.StandardCheckpointer()\n\n        # Create abstract params based on the NEW lora_policy structure (on GRPO Mesh)\n        abs_params = jax.tree.map(\n            lambda x: jax.ShapeDtypeStruct(x.shape, x.dtype),\n            nnx.state(lora_policy, nnx.LoRAParam),\n        )\n\n        # Restore (Auto-reshards from 8,1 -> 1,4)\n        dpo_lora_params = checkpointer.restore(trained_ckpt_path, target=abs_params)\n\n        # Update BOTH models\n        nnx.update(ref_model, dpo_lora_params)\n        nnx.update(lora_policy, dpo_lora_params)\n\n        print(\"✅ DPO weights loaded into both Reference and Policy models.\")\n    else:\n        print(\"⚠️ DPO checkpoint folder empty. Using SFT weights.\")\nelse:\n    print(\"⚠️ DPO checkpoint path not found. Using SFT weights.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Reward function","metadata":{"_uuid":"da82d4ce-220f-43df-a676-81658e8a238e","_cell_guid":"4e6c016c-510f-4d13-95cf-a4bdcb1b4dc9","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"import re\nimport math\n\n# Global flag for debug\nDEBUG_ONCE = True\n\ndef unified_reward_func(prompts, completions, answer, domain, **kwargs):\n    \"\"\"\n    Reward Breakdown (Max 1.0):\n    1. Format (0.4): Strict XML tags.\n    2. Accuracy (0.4): Correct answer found INSIDE tags.\n    3. Bonus (0.1): Awarded only if Format AND Accuracy are perfect.\n    4. Reasoning (0.1): \n       - Must pass Repetition Check (Unique words > 30%)\n       - Target Length: 25 to 600 words.\n    \"\"\"\n    global DEBUG_ONCE\n    rewards = []\n\n    # Regex definitions\n    strict_structure_pattern = r'^<reasoning>[\\s\\S]*?</reasoning>\\s*<answer>[\\s\\S]*?</answer>(?:\\s*<end_of_turn>)?$'\n    extraction_pattern = r\"<reasoning>\\s*(.*?)\\s*</reasoning>\\s*<answer>\\s*(.*?)\\s*</answer>\"\n\n    for i, (content, gt_ans, dom) in enumerate(zip(completions, answer, domain)):\n        \n        # Handle Flax/Tunix passing lists or strings\n        completion_text = content[0]['content'] if isinstance(content, list) else content\n        completion_text_norm = completion_text.strip()\n\n        if DEBUG_ONCE and i == 0:\n            print(f\"\\n[DEBUG] Domain: {dom} | GT: {gt_ans}\")\n            print(f\"[DEBUG] Model Out: {completion_text_norm[:100]}...\")\n            DEBUG_ONCE = False\n\n        # Init scores\n        score_format = 0.0\n        score_accuracy = 0.0\n        score_reasoning = 0.0\n        score_bonus = 0.0\n\n        # =========================================================\n        # 1. FORMAT SCORE (Max 0.4)\n        # =========================================================\n        if re.search(strict_structure_pattern, completion_text_norm, re.IGNORECASE):\n            score_format = 0.4\n        else:\n            # Partial credit (max 0.2)\n            if '<reasoning>' in completion_text_norm: score_format += 0.05\n            if '</reasoning>' in completion_text_norm: score_format += 0.05\n            if '<answer>' in completion_text_norm: score_format += 0.05\n            if '</answer>' in completion_text_norm: score_format += 0.05\n            score_format = min(score_format, 0.2)\n\n        # =========================================================\n        # 2. ATTEMPT EXTRACTION\n        # =========================================================\n        match = re.search(extraction_pattern, completion_text_norm, flags=re.DOTALL | re.IGNORECASE)\n        reasoning_content = match.group(1).strip() if match else \"\"\n        extracted_model_answer = match.group(2).strip() if match else None\n\n        # =========================================================\n        # 3. ACCURACY SCORE (Max 0.4)\n        # =========================================================\n        if extracted_model_answer and gt_ans:\n            model_val = extracted_model_answer.lower().strip().rstrip(\".,;!\")\n            gt_val = str(gt_ans).strip()\n            gt_val_clean = re.sub(r'\\.$', '', gt_val).lower()\n\n            try:\n                is_correct = False\n                # Domain Logic\n                if dom in ['W6', 'PZ1', 'PZ2', 'CS4']:\n                    if model_val == gt_val_clean: is_correct = True\n                elif dom in ['FP1', 'FP2', 'CS1', 'CS2', 'CS3']:\n                    target_num, target_text = \"\", \"\"\n                    if '_' in gt_val_clean:\n                        parts = gt_val_clean.split('_', 1)\n                        target_num, target_text = parts[0].strip(), parts[1].strip()\n                    else:\n                        target_text = gt_val_clean\n                    num_match = target_num and re.search(rf\"\\b{re.escape(target_num)}\\b\", model_val)\n                    text_match = target_text and (target_text in model_val)\n                    if num_match or text_match: is_correct = True\n                else:\n                    if re.search(rf\"\\b{re.escape(gt_val_clean)}\\b\", model_val): is_correct = True\n\n                if is_correct: score_accuracy = 0.4\n            except Exception:\n                score_accuracy = 0.0\n\n        # =========================================================\n        # 4. BONUS SCORE (Max 0.1)\n        # =========================================================\n        if score_format >= 0.4 and score_accuracy >= 0.4:\n            score_bonus = 0.1\n\n        # =========================================================\n        # 5. REASONING SCORE (Max 0.1)\n        # Logic: Repetition Gate -> Length Check\n        # =========================================================\n        if reasoning_content:\n            words = reasoning_content.split()\n            count = len(words)\n            \n            # --- A. REPETITION CHECK (The Gatekeeper) ---\n            # Calculate unique word ratio\n            unique_ratio = len(set(words)) / count if count > 0 else 0\n            \n            # If the model is spamming (less than 30% unique words), it fails immediately.\n            if unique_ratio < 0.3:\n                score_reasoning = 0.0\n            else:\n                # --- B. WORD COUNT CHECK (25 to 600) ---\n                if count < 25:\n                    # Too short: Partial credit (Linear Ramp)\n                    # e.g., 12 words = 0.1 * (12/25) = 0.048\n                    score_reasoning = 0.1 * (count / 25.0)\n                elif count <= 600:\n                    # Sweet Spot: Full credit\n                    score_reasoning = 0.1\n                else:\n                    # Too long: Slight decay to discourage rambling\n                    # Lose 10% of score for every 100 words over limit\n                    excess_factor = (count - 600) / 1000.0\n                    score_reasoning = max(0.0, 0.1 - excess_factor)\n\n        # =========================================================\n        # FINAL SUM\n        # =========================================================\n        total_score = score_format + score_accuracy + score_bonus + score_reasoning\n        rewards.append(total_score)\n\n    return rewards","metadata":{"_uuid":"eec1f277-1608-4cc7-8155-044c2964494e","_cell_guid":"5dfed7a1-77ba-4f4c-8c81-edf54554fd3a","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-07T23:32:09.336763Z","iopub.execute_input":"2026-01-07T23:32:09.337189Z","iopub.status.idle":"2026-01-07T23:32:09.346085Z","shell.execute_reply.started":"2026-01-07T23:32:09.337163Z","shell.execute_reply":"2026-01-07T23:32:09.345320Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":44},{"cell_type":"code","source":"# Ckpt saving\ncheckpointing_options = ocp.CheckpointManagerOptions(\n    save_interval_steps=SAVE_INTERVAL_STEPS, max_to_keep=MAX_TO_KEEP\n)\n\n# Metrics logger\nmetrics_logging_options = metrics_logger.MetricsLoggerOptions(\n    log_dir=\"/tmp/content/tmp/tensorboard/grpo2\", flush_every_n_steps=20\n)","metadata":{"_uuid":"3e73410b-3461-49ea-ab83-df34fc6e27c8","_cell_guid":"29f66183-0a8f-4114-b9c3-dbe66c534bb4","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-07T23:32:10.986676Z","iopub.execute_input":"2026-01-07T23:32:10.986916Z","iopub.status.idle":"2026-01-07T23:32:10.989916Z","shell.execute_reply.started":"2026-01-07T23:32:10.986886Z","shell.execute_reply":"2026-01-07T23:32:10.989166Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":45},{"cell_type":"code","source":"optimizer = optax.adamw(\n    learning_rate=optax.schedules.warmup_cosine_decay_schedule(\n        init_value=0.0,\n        peak_value=LEARNING_RATE,\n        warmup_steps=WARMUP_STEPS, \n        decay_steps=int(MAX_STEPS),\n        end_value=0.0,\n    ),\n    b1=B1,\n    b2=B2,\n    weight_decay=WEIGHT_DECAY,\n)\n\n# 3. Add Gradient Clipping\nif MAX_GRAD_NORM is not None:\n  optimizer = optax.chain(\n      optax.clip_by_global_norm(max_norm=MAX_GRAD_NORM),\n      optimizer,\n  )","metadata":{"_uuid":"8b205026-b35b-487b-9009-4a443c167691","_cell_guid":"015cd646-ef2e-48b2-a65a-a2551cfe9bf6","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-07T23:32:11.630247Z","iopub.execute_input":"2026-01-07T23:32:11.630482Z","iopub.status.idle":"2026-01-07T23:32:11.633832Z","shell.execute_reply.started":"2026-01-07T23:32:11.630463Z","shell.execute_reply":"2026-01-07T23:32:11.633125Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":46},{"cell_type":"code","source":"# Training config\ncluster_config = rl_cluster_lib.ClusterConfig(\n    role_to_mesh={\n        rl_cluster_lib.Role.ACTOR: grpo_mesh,\n        rl_cluster_lib.Role.REFERENCE: grpo_mesh,\n        rl_cluster_lib.Role.ROLLOUT: grpo_mesh,\n    },\n    rollout_engine='vanilla',\n    offload_to_cpu=False,\n    training_config=rl_cluster_lib.RLTrainingConfig(\n        actor_optimizer=optimizer,\n        eval_every_n_steps=EVAL_EVERY_N_STEPS,\n        max_steps=MAX_STEPS,\n        mini_batch_size=MINI_BATCH_SIZE,\n        train_micro_batch_size=TRAIN_MICRO_BATCH_SIZE,\n        # metrics logging\n        metrics_logging_options=metrics_logging_options,\n        # checkpoint saving\n        checkpoint_root_directory=CKPT_DIR,\n        checkpointing_options=checkpointing_options,\n    ),\n    rollout_config=base_rollout.RolloutConfig(\n        max_tokens_to_generate=TOTAL_GENERATION_STEPS,\n        max_prompt_length=MAX_PROMPT_LENGTH,\n        kv_cache_size=MAX_PROMPT_LENGTH + TOTAL_GENERATION_STEPS + 256,\n        temperature=TEMPERATURE,\n        top_p=TOP_P,\n        top_k=TOP_K,\n        eos_tokens=[1,106],\n    ),\n)\n\ngrpo_config = GRPOConfig(\n    num_generations=NUM_GENERATIONS,\n    num_iterations=NUM_ITERATIONS,\n    beta=BETA,\n    epsilon=EPSILON,\n)\n\n\n# RL cluster\nrl_cluster = rl_cluster_lib.RLCluster(\n    actor=lora_policy,\n    reference=ref_model,\n    tokenizer=tokenizer,\n    cluster_config=cluster_config,\n)\n\n# GRPO Trainer\ngrpo_trainer = GRPOLearner(\n    rl_cluster=rl_cluster,\n    reward_fns=[\n        unified_reward_func,\n    ],\n    grpo_config=grpo_config,\n)","metadata":{"_uuid":"715f0439-c95e-4a22-be00-b016f99ffc39","_cell_guid":"73e30959-6dd6-47bb-8aed-06907d40a838","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-07T23:32:12.494593Z","iopub.execute_input":"2026-01-07T23:32:12.494897Z","iopub.status.idle":"2026-01-07T23:32:20.932737Z","shell.execute_reply.started":"2026-01-07T23:32:12.494875Z","shell.execute_reply":"2026-01-07T23:32:20.931685Z"},"jupyter":{"outputs_hidden":false}},"outputs":[{"name":"stderr","text":"WARNING:absl:Reference model and actor model are colocated but do not share the same backbone. This will result in an unne