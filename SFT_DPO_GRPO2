},{"cell_type":"markdown","source":"## END OF STORY","metadata":{}},{"cell_type":"markdown","source":"## Multiple Kaggle sessions","metadata":{}},{"cell_type":"code","source":"import kagglehub\n\n# -----------------------------------------------------------------------------\n# CONFIGURATION\n# -----------------------------------------------------------------------------\n# 1. Your Kaggle Username (Must match the account you are submitting from)\nKAGGLE_USERNAME = \"sandeeplleb\" \n\n# 2. A name for your model (slug). Can be anything, e.g., 'tunix-gemma2-grpo'\nMODEL_SLUG = \"tunix-gemma2-2b-grpo-final\"\n\n# 3. The directory containing your final LoRA parameters\n# Based on your previous cell:\nlocal_weights_dir = \"/tmp/content/grpo2/lora_final/\" \n\n# -----------------------------------------------------------------------------\n# UPLOAD TO KAGGLE MODEL HUB\n# -----------------------------------------------------------------------------\n# The full handle format is: owner/slug/framework/variation\n# We use 'flax' as the framework and 'lora-adapter' as the variation\nfull_handle = f\"{KAGGLE_USERNAME}/{MODEL_SLUG}/flax/lora-adapter\"\n\nprint(f\"🚀 Uploading model from '{local_weights_dir}' to '{full_handle}'...\")\n\ntry:\n    # This uploads the folder containing 'model_params'\n    kagglehub.model_upload(\n        handle=full_handle,\n        local_model_dir=local_weights_dir,\n        license_name=\"Apache 2.0\",\n        version_notes=\"Final GRPO trained LoRA adapter\"\n    )\n    print(\"✅ Model uploaded successfully!\")\nexcept Exception as e:\n    print(f\"❌ Upload failed: {e}\")\n    print(\"Tip: If the model doesn't exist yet, kagglehub usually creates it.\")\n    print(\"If it fails, you can also download the 'grpo_lora_checkpoint.zip' and upload it manually via the Kaggle website.\")\n\n# -----------------------------------------------------------------------------\n# REQUIRED SUBMISSION VARIABLE\n# -----------------------------------------------------