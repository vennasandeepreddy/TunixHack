---------------------------------------------------\n# The full handle format is: owner/slug/framework/variation\n# We use 'flax' as the framework and 'lora-adapter' as the variation\nfull_handle = f\"{KAGGLE_USERNAME}/{MODEL_SLUG}/flax/lora-adapter\"\n\nprint(f\"🚀 Uploading model from '{local_weights_dir}' to '{full_handle}'...\")\n\ntry:\n    # This uploads the folder containing 'model_params'\n    kagglehub.model_upload(\n        handle=full_handle,\n        local_model_dir=local_weights_dir,\n        license_name=\"Apache 2.0\",\n        version_notes=\"Final GRPO trained LoRA adapter\"\n    )\n    print(\"✅ Model uploaded successfully!\")\nexcept Exception as e:\n    print(f\"❌ Upload failed: {e}\")\n    print(\"Tip: If the model doesn't exist yet, kagglehub usually creates it.\")\n    print(\"If it fails, you can also download the 'grpo_lora_checkpoint.zip' and upload it manually via the Kaggle website.\")\n\n# -----------------------------------------------------------------------------\n# REQUIRED SUBMISSION VARIABLE\n# -----------------------------------------------------------------------------\n# The Hackathon rules require this specific variable name.\n# It should match the URL: https://www.kaggle.com/models/USERNAME/MODEL_SLUG\n\nunrestricted_kaggle_model = f\"{KAGGLE_USERNAME}/{MODEL_SLUG}\"\n\nprint(\"=\"*80)\nprint(f\"FINAL SUBMISSION ID: {unrestricted_kaggle_model}\")\nprint(\"Make sure this variable is the last thing defined in your notebook.\")\nprint(\"=\"*80)","metadata":{"_uuid":"b6121850-149d-4fee-8282-833c3f8ebffb","_cell_guid":"205866d2-ff1a-4b8b-aaad-7112ab201536","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport kagglehub\nfrom flax import nnx\nimport orbax.checkpoint as ocp\n\n# -----------------------------------------------------------------------------\n# CONFIGURATION\n# -----------------------------------------------------------------------------\nKAGGLE_USERNAME = \"sandeeplleb\"  # Your Kaggle Username\n# Give this a DIFFERENT name/slug so it doesn't overwrite your LoRA submission\nFULL_MODEL_SLUG = \"tunix-gemma2-2b-grpo-full-model\" \n\n# Directory to save the heavy full model\nFULL_MODEL_DIR = \"/tmp/content/grpo2/full_model_export/\"\n\n# -----------------------------------------------------------------------------\n# 1. SAVE THE FULL MODEL STATE LOCALLY\n# -----------------------------------------------------------------------------\nprint(f\"💾 Saving full model state to {FULL_MODEL_DIR}...\")\nprint(\"This may take a minute as it is writing ~5GB to disk...\")\n\n# Ensure directory exists\nif os.path.exists(FULL_MODEL_DIR):\n    import shutil\n    shutil.rmtree(FULL_MODEL_DIR)\nos.makedirs(FULL_MODEL_DIR, exist_ok=True)\n\n# Save the entire state of lora_policy (Base Weights + LoRA Weights)\n# We use StandardCheckpointer to handle the sharded arrays\ncheckpointer = ocp.StandardCheckpointer()\ncheckpointer.save(\n    os.path.join(FULL_MODEL_DIR, \"model_params\"), \n    nnx.state(lora_policy)\n)\n\nprint(f\"✅ Full model saved locally at: {FULL_MODEL_DIR}\")\nprint(f\"   Size check:\")\n!du -sh {FULL_MODEL_DIR}\n\n# -----------------------------------------------------------------------------\n# 2. UPLOAD TO KAGGLE MODEL HUB\n# -----------------------------------------------------------------------------\n# We use a distinct handle for the full model\nfull_handle = f\"{KAGGLE_USERNAME}/{FULL_MODEL_SLUG}/flax/full-weights\"\n\nprint(f\"\\n🚀 Uploading FULL model to '{full_handle}'...\")\nprint(\"⚠️ NOTE: This is a large upload (~5GB). Do not close the tab.\")\n\ntry:\n    kagglehub.model_upload(\n        handle=full_handle,\n        local_model_dir=FULL_MODEL_DIR,\n        license_name=\"Apache 2.0\",\n        version_notes=\"Full Gemma2-2B + GRPO LoRA weights (unmerged state)\"\n    )\n    print(\"✅ Full Model uploaded successfully!\")\n    print(f\"🔗 View it here: https://www.kaggle.com/models/{full_handle}\")\nexcept Exception as e:\n    print(f\"❌ Upload failed: {e}\")","metadata":{"_uuid":"24bf7fd4-25f9-4902-af2b-6aa8dc685a37","_cell_guid":"a96222a5-9023-47b4-aa79-27809a00f427","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Let Model generate responses for some of the DPO datasets","metadata":{"_uuid":"fde7d605-733e-4d56-b853-fa1aed4d1b8a","_cell_guid":"ec83142c-9b2a-4ef7-9b3d-834979089265","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def get_df():\n    return kagglehub.dataset_load(\n  KaggleDatasetAdapter.PANDAS,\n  \"sandeeplleb/dpo-final\",\n  \"DPO_v4.xlsx\",\n)\n\ndpo_df = get_df()\ndpo_df.head()","metadata":{"_uuid":"0992efd5-2d0b-42b2-b31b-16e5ea4e46f2","_cell_guid":"6b0d28f2-4d87-43ed-84b4-92f277620b9c","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"dpo_df_sample = dpo_df.sample(n=1000)","metadata":{"_uuid":"b4bf4d1d-9b92-42b1-a8eb-8821a49f0050","_cell_guid":"1b7bc459-7da2-4615-a5e0-fee59b9bf563","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"sampler = sampler_lib.Sampler(\n    transformer=lora_policy,\n    tokenizer=tokenizer,\n    cache_config=sampler_lib.CacheConfig(\n        cache_size= 2048,\n        num_layers=model_config.num_layers,\n        num_kv_heads=model_config.num_kv_heads,\n        head_dim=model_config.head_dim,\n    ),\n)","metadata":{"_uuid":"9e1f8ec7-8ac0-4be8-9b12-ffa5bc7f4921","_cell_guid":"952b4322-8881-449b-8cbf-d8891bcc006c","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"prompts = dpo_df_sample['prompt'].tolist()\ninf_batch_size = 4\nresults = []\n\nfor i in tqdm(range(0, len(prompts), inf_batch_size))