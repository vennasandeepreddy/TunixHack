om file. Note also that this option is unsafe when restoring on a different topology than the checkpoint was saved with.\n  warnings.warn(\n","output_type":"stream"},{"name":"stdout","text":"✅ DPO weights loaded into both Reference and Policy models.\n","output_type":"stream"}],"execution_count":166},{"cell_type":"code","source":"def force_reshard_model(model, mesh):\n    \"\"\"\n    Forces all parameters in the model to be sharded according to the target mesh.\n    This fixes the conflict between (8,1) parameters and (1,4) parameters.\n    \"\"\"\n    # 1. Get the current state\n    state = nnx.state(model)\n    \n    # 2. Get the PartitionSpec defined by the model architecture\n    pspecs = nnx.get_partition_spec(state)\n    \n    # 3. Create the concrete NamedSharding for the GRPO mesh\n    target_sharding = nnx.get_named_sharding(pspecs, mesh)\n    \n    # 4. Force JAX to move/reshard the data to this new layout\n    #    This unifies the (8,1) DPO weights into the (1,4) GRPO layout\n    sharded_state = jax.device_put(state, target_sharding)\n    \n    # 5. Update the model with the clean, consistent state\n    nnx.update(model, sharded_state)\n\nprint(\"🔄 Force-resharding models to GRPO Mesh (1, 4)...\")\nwith grpo_mesh:\n    force_reshard_model(ref_model, grpo_mesh)\n    force_reshard_model(lora_policy, grpo_mesh)\nprint(\"✅ Resharding complete. Mesh consistency ensured.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-09T01:35:50.135324Z","iopub.execute_input":"2026-01-09T01:35:50.135604Z","iopub.status.idle":"2026-01-09T01:35:50.599767Z","shell.execute_reply.started":"2026-01-09T01:35:50.135584Z","shell.execute_reply":"2026-01-09T01:35:50.598390Z"}},"outputs":[{"name":"stdout","text":"🔄 Force-resharding models to GRPO Mesh (1, 4)...\n✅ Resharding complete. Mesh consistency ensured.\n","output_type":"stream"}],"execution_count":167},{"cell_type":"code","source":"import gc\nimport jax\n\nprint(\"🧹 Cleaning up intermediate loading variables...\")\n\n# These variables were only needed to create ref_model and lora_policy.\n# Now that the final models are ready and resharded, we can kill these.\nloading_artifacts = [\n    'base_model_ref', \n    'base_model_policy', \n    'graph_def', \n    'params', \n    'abs_params', \n    'dpo_lora_params', \n    'checkpointer'\n]\n\nfor var in loading_artifacts:\n    if var in globals():\n        del globals()[var]\n        print(f\"   -> Deleted: {var}\")\n\n# Force release\ngc.collect()\njax.clear_caches()\n\n# Check memory to confirm we have plenty of room for the Trainer\ntry:\n    used = jax.local_devices()[0].memory_stats()['bytes_in_use'] / 1e9\n    print(f\"✅ Memory Cleaned. Current Usage: {used:.2f} GB\")\nexcept:\n    pass","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Reward function","metadata":{"_uuid":"da82d4ce-220f-43df-a676-81658e8a238e","_cell_guid":"4e6c016c-510f-4d13-95cf-a4bdcb1b4dc9","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"import re\nimport math\n\n# Global flag for debug\nDEBUG_ONCE = True\n\ndef unified_reward_func(prompts, completions, answer, domain, **kwargs):\n    \"\"\"\n    Reward Breakdown (Max 1.0):\n    1. Format (0.4): Strict XML tags.\n    2. Accuracy (0.4): Correct answer found INSIDE tags.\n    3. Bonus (0.1): Awarded only if Format AND Accuracy are perfect.\n    4. Reasoning (0.1): \n       - Must pass Repetition Check (Unique words > 30%)\n       - Target Length: 25 to 600 words.\n    \"\"\"\n    global DEBUG_ONCE\n    rewards = []\n\n    # Regex definitions\n    strict_structure_pattern = r'^<reasoning>[\\s\\S]*?</reasoning>\\s*<answer>[\\s\\S]*?</answer>(?:\\s*<end_of_turn>)?$'\n    extraction_pattern = r\"<reasoning>\\s*(.*?)\\s*</reasoning>\\s*<answer>\\s*(.*?)\\s*</answer>\"\n\n    for i, (content, gt_ans, dom) in enumerate(zip(completions, answer, domain)):\n        \n        # Handle Flax/Tunix passing lists or strings\n        completion_text = content[0]['content'] if isinstance(content, list) else content\n        completion_text_norm = completion_text.strip()\n\n        if DEBUG_ONCE and i == 0:\n            print(f\"\\n[DEBUG] Domain: {dom} | GT: {gt_ans}\")\n            print(f\"[DEBUG] Model Out: {completion_text_norm[:100]}...\")\n            DEBUG_ONCE = False\n\n        # Init scores\n        score_format = 0.0\n        score_accuracy = 0.0\n        score_reasoning = 0.0\n        score_bonus = 0.0\n\n        # =========================================================\n        # 1. FORMAT SCORE (Max 0.4)\n        # =========================================================\n        if re.search(strict_structure_pattern, completion_text_norm, re.IGNORECASE):\n            score_format = 0.4\n        else:\n            # Partial credit (max 0.2)\n            if '<reasoning>' in completion_text_norm: score_format += 0.05\n            if '</reasoning>' in completion_text_norm: score_format += 0.05\n            if '<answer>' in completion_text_norm: score_format += 0.05\n            if '</answer>' in completion_text_norm: score_format += 0.05\n            score_format = min(score_format, 0.2)\n\n        # =========================================================\n        # 2. ATTEMPT EXTRACTION\n        # =========================================================\n        match = re.search(extraction_pattern, completion_text_norm, flags=re.DOTALL | re.IGNORECASE)\n        reasoning_content = match.group(1).strip() if match else \"\"\n        extracted_model_answer = match.group(2).strip() if match else None\n\n        # =========================================================\n        # 3. ACCURACY SCORE (Max 0.4)\n        # =========================================================\n        if extracted_model_answer and gt_ans:\n            model_val = extracted_model_answer.lower().strip().rstrip(\".,;!\")\n            gt_val = str(gt_ans).strip()\n            gt_val_clean = re.sub(r'\\.$', '', gt_val).lower()\n\n            try:\n                is_correct = False\n                # Domain Logic\n                if dom in ['W6', 'PZ1', 'PZ2', 'CS4']:\n                    if model_val == gt_val_clean: is_correct = True\n                elif dom in ['FP1', 'FP2', 'CS1', 'CS2', 'CS3']:\n                    target_num, target_text = \"\", \"\"\n                    if '_' in gt_val_clean:\n                        parts = gt_val_clean.split('_', 1)\n                        target_num, target_text = parts[0].strip(), parts[1].strip()\n                    else:\n                        target_text = gt_val_clean\n                    num_match = target_num and re.search(rf\"\\b{re.escape(target_num)}\\b\", model_val)\n                    text_match = target_text and (target_text in model_val)\n                    if num_match or text_match: is_correct = True\n                else:\n                    if re.search(rf\"\\b{re.escape(gt_val_clean)}\\b\", model_val): is_correct = True\n\n                if is_correct: score_accuracy = 0.4\n            except Exception:\n                score_accuracy = 0.0\n\n        # =========================================================\n        # 4. BONUS SCORE (Max 0.1)\n        # =========================================================\n        if score_format >= 0.4 and score_accuracy >= 0.4:\n            score_bonus = 0.1\n\n        # =========================================================\n        # 5. REASONING SCORE (Max 0.1)\n        # Logic: Repetition Gate -> Length Check\n        # =========================================================\n        if reasoning_content:\n            words = reasoning_content.split()\n            count = len(words)\n            \n            # --- A. REPETITION CHECK (The Gatekeeper) ---\n            # Calculate unique word ratio\n            unique_ratio = len(set(words)) / count if count > 0 else 0\n            \n            # If the model is spamming (less than 30% unique words), it fails immediately.\n            if unique_ratio < 0.3:\n                score_reasoning = 0.0\n            else:\n                # --- B. WORD COUNT CHECK (25 to 600) ---\n                if count < 25:\n                    # Too short: Partial credit (Linear Ramp)\n                    # e.g., 12 words = 0.1 * (12/25) = 0.048\n                    score_reasoning = 0.1 * (count / 25.0)\n                elif count <= 600:\n                    # Sweet Spot: Full credit\n                    score_reasoning = 0.1\n                else:\n                    # Too long: Slight decay to discourage rambling\n                    # Lose 10% of score for every 100 words over limit\n                    excess_factor = (count - 600) / 1000.0\n                    score_reasoning = max(0.0, 0.1 - excess_factor)\n\n        # =========================================================\n        # FINAL SUM\n        # =========================================================\n        total_score = score_format + score_accuracy + score_bonus + score_reasoning\n        rewards.append(total_score)\n\n    return rewards","metadata":{"_uuid":"eec1f277-1608-4cc7-8155-044c2964494e","_cell_guid":"5dfed7a1-77ba-4f4c-8c81-edf54554fd3a","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-09T00:44:52.612698Z","iopub.execute_input":"2026-01-09T00:44:52.612967Z","iopub.status.idle":"2026-01-09T00:44:52.627290Z","shell.execute_reply.started":"2026-01-09T00:44:52.612949Z","shell.execute_reply":"2026-01-09T00:44:52.626221Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":109},{"cell_type":"code","source":"# Ckpt saving\ncheckpointing_options = ocp.CheckpointManagerOptions(\n    save_interval_steps=SAVE_INTERVAL_STEPS, max_to_keep=MAX_TO_KEEP\n)\n\n# Metrics logger\nmetrics_logging_options = metrics_logger.MetricsLoggerOptions(\n    log_dir=\"/tmp/content/tmp/tensorboard/grpo2\", flush_every_n_steps=20\n)","metadata":{"_u