= nnx.state(lora_model)\n    pspecs = nnx.get_partition_spec(state)\n    sharded_state = jax.lax.with_sharding_constraint(state, pspecs)\n    nnx.update(lora_model, sharded_state)\n\n  return lora_model","metadata":{"_uuid":"5e3cf3c6-dc1a-41db-96c0-5b25b76cc0b6","_cell_guid":"8d91fbc9-1444-43ff-a360-5a7a68e2f6ec","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-08T23:18:12.015423Z","iopub.execute_input":"2026-01-08T23:18:12.015705Z","iopub.status.idle":"2026-01-08T23:18:12.021729Z","shell.execute_reply.started":"2026-01-08T23:18:12.015682Z","shell.execute_reply":"2026-01-08T23:18:12.020533Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":21},{"cell_type":"code","source":"# Reference model\nif model_family == \"gemma2\":\n  ref_model, mesh, model_config = get_gemma_ref_model(\n      ckpt_path=os.path.join(SFT_INTERMEDIATE_CKPT_DIR, \"state\")\n  )\n\n# Policy model\nlora_policy = get_lora_model(ref_model, mesh=mesh)\n\n#Tokenizer\nif model_family == \"gemma2\":\n  tokenizer = tokenizer_lib.Tokenizer(\n      tokenizer_path=os.path.join(kaggle_ckpt_path, \"tokenizer.model\")\n  )","metadata":{"_uuid":"6dddc7c4-680d-4a03-b20d-568346cf4b00","_cell_guid":"4161d53e-6df4-451d-9d1b-76c4dd759e04","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-08T23:18:12.287011Z","iopub.execute_input":"2026-01-08T23:18:12.287195Z","iopub.status.idle":"2026-01-08T23:18:28.281096Z","shell.execute_reply.started":"2026-01-08T23:18:12.287179Z","shell.execute_reply":"2026-01-08T23:18:28.279756Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":22},{"cell_type":"markdown","source":"## 1. Grain Dataset","metadata":{"_uuid":"5e93b8a1-44a8-4f4b-9705-31ed73ee8f25","_cell_guid":"0aee6a84-ac1a-431d-932b-82d8b78c6bf4","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def check_truncation_stats(data_list, name=\"Dataset\"):\n    truncated_count = 0\n    max_len_found = 0\n    lengths = []\n    print(f\"--- Analyzing {name} ---\")\n    for item in tqdm(data_list):\n        tokens = tokenizer.encode(item[\"text\"])\n        seq_len = len(tokens)\n        lengths.append(seq_len)\n        \n        if seq_len > max_len_found:\n            max_len_found = seq_len\n            \n        if seq_len > MAX_SEQ_LENGTH:\n            truncated_count += 1\n            \n    # Statistics\n    total = len(data_list)\n    percent = (truncated_count / total) * 100\n    \n    print(f\"\\nResults for {name}:\")\n    print(f\"✅ Total Samples: {total}\")\n    print(f\"⚠️ Truncated Samples: {truncated_count} ({percent:.2f}%)\")\n    print(f\"📏 Max Sequence Length Found: {max_len_found}\")\n    print(f\"🛑 Limit (MAX_SEQ_LENGTH): {MAX_SEQ_LENGTH}\")\n    \n    if truncated_count > 0:\n        print(f\"👉 You are losing data in {truncated_count} rows. Consider increasing MAX_SEQ_LENGTH if possible.\")\n    else:\n        print(\"🎉 No truncation! Your MAX_SEQ_LENGTH is safe.\")\n    print(\"=\"*40)\n\n# Run the check on both Train and Test\ncheck_truncation_stats(formatted_train_data, name=\"Training Data\")\ncheck_truncation_stats(formatted_test_data, name=\"Test Data\")","metadata":{"_uuid":"652ba68d-1a0a-4bdf-aac0-f40c76e9396f","_cell_guid":"13d15ab1-cb18-441f-8d6d-84a1de4a601d","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-08T23:18:30.807239Z","iopub.execute_input":"2026-01-08T23:18:30.807464Z","iopub.status.idle":"2026-01-08T23:18:34.210879Z","shell.execute_reply.started":"2026-01-08T23:18:30.807445Z","shell.execute_reply":"2026-01-08T23:18:34.209371Z"}},"outputs":[{"name":"stdout","text":"--- Analyzing Training Data ---\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 3025/3025 [00:03<00:00, 919.20it/s]\n","output_type":"stream"},{"name":"stdout","text":"\nResults for Training Data:\n✅ Total Samples: 3025\n⚠️ Truncated Samples: 0 (0.00%)\n📏 Max Sequence Length Foun