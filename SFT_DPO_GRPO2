c-4d16-b499-2c52ae9375d2","_cell_guid":"401772e0-1464-4faa-a077-37b69d627cb7","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T17:20:56.612589Z","iopub.execute_input":"2026-01-10T17:20:56.612921Z","iopub.status.idle":"2026-01-10T17:20:56.631053Z","shell.execute_reply.started":"2026-01-10T17:20:56.612901Z","shell.execute_reply":"2026-01-10T17:20:56.630083Z"}},"outputs":[{"name":"stdout","text":"📄 Logging set to: /kaggle/working/grpo_training_log.txt\n","output_type":"stream"}],"execution_count":112},{"cell_type":"code","source":"import sys\nimport random\n\n# --- LOGGING CONFIGURATION ---\n# Probability of printing a row (0.05 = ~5% of samples). \n# Adjust to 1.0 if you want to see EVERYTHING (warning: very verbose), \n# or 0.01 for a light sampling.\nDEBUG_PRINT_RATE = 0.1 \n\n# Helper to robustly convert JAX/Numpy/Bytes to Python Strings\ndef _to_scalar_str(x) -> str:\n    if x is None: return \"\"\n    if hasattr(x, \"ndim\"): # checks for numpy/jax array\n        if x.ndim == 0: x = x.item()\n        elif x.size == 1: x = x.reshape(()).item()\n        else:\n            x0 = x.reshape(-1)[0]\n            x = x0.item() if hasattr(x0, \"item\") else x0\n    if hasattr(x, \"item\") and not isinstance(x, (str, bytes, bytearray)):\n        try: x = x.item()\n        except: pass\n    if isinstance(x, (bytes, bytearray)):\n        return x.decode(\"utf-8\", errors=\"ignore\")\n    return str(x)","metadata":{"_uuid":"2b2b42cc-3a0e-4cda-9a38-4402292d399b","_cell_guid":"e67146cb-cfa2-4dd9-8da2-38ce7714c03e","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T17:56:44.011247Z","iopub.execute_input":"2026-01-10T17:56:44.011532Z","iopub.status.idle":"2026-01-10T17:56:44.016983Z","shell.execute_reply.started":"2026-01-10T17:56:44.011514Z","shell.execute_reply":"2026-01-10T17:56:44.016059Z"}},"outputs":[],"execution_count":139},{"cell_type":"code","source":"import re\nimport math\n\n# Global flag for debug\nDEBUG_ONCE = True\n\ndef unified_reward_func(prompts, completions, answer, domain, **kwargs):\n    \"\"\"\n    Reward Breakdown (Max 1.0):\n    1. Format (0.4): Strict XML tags.\n    2. Accuracy (0.4): Correct answer found INSIDE tags.\n    3. Reasoning (0.1): Structure, Length, Logic, Convergence.\n    4. Bonus (0.1): \"Trifecta\" -> Perfect Format + Accuracy + High Quality Reasoning.\n    \"\"\"\n    global DEBUG_ONCE\n    rewards = []\n\n    # Regex definitions\n    strict_structure_pattern = r'^<reasoning>[\\s\\S]*?</reasoning>\\s*<answer>[\\s\\S]*?</answer>(?:\\s*<end_of_turn>)?$'\n    extraction_pattern = r\"<reasoning>\\s*(.*?)\\s*</reasoning>\\s*<answer>\\s*(.*?)\\s*</answer>\"\n\n    # GRPO: completions has batch_size * NUM_GENERATIONS items, while answer/domain are batch_size.\n    # So we score each completion and map back to its prompt via i // NUM_GENERATIONS.\n    # NOTE: wrap scalars as singletons; do NOT use list(x) (strings become list of chars).\n    if answer is not None and not isinstance(answer, list):\n        answer = [answer]\n    if domain is not None and not isinstance(domain, list):\n        domain = [domain]\n\n    for i, content in enumerate(completions):\n        batch_idx = i // NUM_GENERATIONS\n        gt_ans = answer[batch_idx] if answer is not None and batch_idx < len(answer) else \"\"\n        dom = domain[batch_idx] if domain is not None and batch_idx < len(domain) else \"\"\n\n        # Handle Flax/Tunix passing lists or strings\n        completion_text = content[0]['content'] if isinstance(content, list) else content\n        completion_text_norm = completion_text.strip()\n\n        if DEBUG_ONCE and i == 0:\n            print(f\"\\n[DEBUG] Domain: {dom} | GT: {gt_ans}\")\n            print(f\"[DEBUG] Model Out: {completion_text_norm[:100]}...\")\n            DEBUG_ONCE = False\n\n        # Init scores\n        score_format = 0.0\n        score_accuracy = 0.0\n        score_reasoning = 0.0\n        score_bonus = 0.0\n\n        # =========================================================\n        # 1. FORMAT SCORE (Max 0.4)\n        # =========================================================\n        if re.search(strict_structure_pattern, completion_text_norm, re.IGNORECASE):\n            score_format = 0.4\n        else:\n            # Partial credit (max 0.2)\n            if '<reasoning>' in completion_text_norm: score_format += 0.05\n            if '</reasoning>' in completion_text_norm: score_format += 0.05\n            if '<answer>' in completion_text_norm: score_format += 0.05\n            if '</answer>' in completion_text_norm: score_format += 0.05\n            score_format = min(score_format, 0.2)\n\n        # =========================================================\n        # 2. ATTEMPT EXTRACTION\n        # =========================================================\n        match = re.search(extraction_pattern, completion_text_norm, flags=re.DOTALL | re.IGNORECASE)\n        reasoning_content = match.group(1).strip() if match else \"\"\n        extracted_model_answer = match.group(2).strip() if match else None\n\n        # =========================================================\n        # 3. ACCURACY SCORE (Max 0.4)\n        # =========================================================\n        if extracted_model_answer and gt_ans:\n            model_val = extracted_model_answer.lower().strip().rstrip(\".,;!\")\n            gt_val = str(gt_ans).strip()\n            gt_val_clean = re.sub(r'\\.$', '', gt_val).lower()\n\n            try:\n                is_correct = False\n                # Domain Logic\n                if dom in ['W6', 'PZ1', 'PZ2', 'CS4']:\n                    if model_val == gt_val_clean: is_correct = True\n                elif dom in ['FP1', 'FP2', 'CS1', 'CS2', 'CS3']:\n                    target_num, target_text = \"\", \"\"\n                    if '_' in gt_val_clean:\n                        parts = gt_val_clean.split('_', 1)\n                        target_num, target_text = parts[0].strip(), parts[1].strip()\n                    else:\n                        target_text = gt_val_clean\n                    num_match = target_num and re.search(rf\"\\b{re.escape(target_num)}\\b\", model_val)\n                    text_match = target_text and (target_text in model_val)\n                    if num_match or text_match: is_correct = True\n                else:\n                    if re.search(rf\"\\b{re.escape(gt_val_clean)}\\b\", model_val): is_correct = True\n\n                if is_correct: score_accuracy = 0.4\n            except Exception:\n                score_accuracy = 0.0\n\n        # =========================================================\n        # 4. REASONING SCORE (Max 0.1)\n        # =========================================================\n        if reasoning_content:\n            words = reasoning_content.split()\n            count = len(words)\n\n            # --- GATE: REPETITION CHECK ---\n            unique_ratio = len(set(words)) / count if count > 0 else 0\n\n            if unique_ratio < 0.3 or count < 10:\n                score_reasoning = 0.0\n            else:\n                # A. BASE LENGTH (Max 0.02)\n                if count < 40:\n                    r_len = 0.02 * (count / 40.0)\n                elif count <= 600:\n                    r_len = 0.02\n                else:\n                    excess = (count - 600) / 1000.0\n                    r_len = max(0.0, 0.02 - excess)\n\n                # B. STRUCTURE CHECK (Max 0.03)\n                r_structure = 0.0\n                if reasoning_content.count('\\n') >= 2:\n                    r_structure += 0.01\n                if re.search(r'(\\n\\d+\\.|\\n-\\s|\\bStep\\s\\d)', reasoning_content):\n                    r_structure += 0.02\n                r_structure = min(r_structure, 0.03)\n\n                # C. LOGICAL FLOW CHECK (Max 0.02)\n                r_flow = 0.0\n                connectors = ['therefore', 'because', 'since', 'implies', 'thus', 'so', 'consequently']\n                found_connectors = sum(1 for c in connectors if c in reasoning_content.lower())\n                if found_connectors >= 2:\n                    r_flow = 0.02\n                elif found_connectors == 1:\n                    r_flow = 0.01\n\n                # D. CONVERGENCE CHECK (Max 0.03)\n                r_conv = 0.0\n                if extracted_model_answer:\n                    tail_segment = reasoning_content[-300:].lower()\n                    ans_val = extracted_model_answer.lower().strip()\n                    if ans_val in tail_segment:\n                        r_conv = 0.03\n\n                score_reasoning = min(r_len + r_structure + r_flow + r_conv, 0.1)\n\n        # =========================================================\n        # 5. BONUS SCORE (Max 0.1)\n        # THE TRIFECTA: Perfect Format + Perfect Accuracy + Good Reasoning\n        # =========================================================\n        # Threshold 0.08 ensures the model got 80% of reasoning points\n        # (meaning it likely had good length + structure + convergence)\n        if score_format == 0.4 and score_accuracy == 0.4 and score_reasoning >= 0.08:\n            score_bonus = 0.1\n\n        # =========================================================\n        # FINAL SUM\n        # =========================================================\n        total_score = score_format + score_accuracy + score_bonus + score_reasoning\n        rewards.append(total_score)\n\n    return rewards","metadata":{"_uuid":"3f9f58c5-12aa-475a-9239-7c0b58840997","_cell_guid":"267a9f41-b6de-4d2f-954d-6f21dd33f8d5","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-10T17:56:44.313427Z","iopub.execute_input":"2026-01-10T17:56:44.313636Z","iopub.status.idle":"2026-01-10T17:56:44.326237Z","shell.execute_reply.started":"2026-01-10T17:56:44.313610Z","shell.execute_reply":"2026-01-10T17:56:44.325411Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":140},{"cell_type":"code","source":"reasoning_start, reasoning_end = \"<reasoning>\", \"</reasoning>\"\nanswer_start, answer_end = \"<answer>\", \"</answer>\"","metadata":{"_uuid":"fbc0b802-1994-4ec8-8fe8-75792af2d255","_cell_guid":"1f53e57c-fdd0-47a4-bb63-2640f13544ed","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-10T17:56:44.515881Z","iopub.execute_input":"2026-01-10T17:56:44.516040Z","iopub.status.idle":"2026-01-10T17:56:44.519525Z","shell.execute_reply.started":"2026-01-10T17:56:44.516026Z","shell.execute_reply":"2026-01-10T17:56:44.518658Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":141},{"cell_type":"code","source":"import re\n\n# 1. Define Regex Patterns (Strict and Loose)\n# Strict: Enforces structure exactness\nstrict_format_pattern = re.compile(\n    r\"^<reasoning>[\\s\\S]*?</reasoning>\\s*<answer>[\\s\\S]*?</answer>(?:\\s*<end_of_turn>)?$\",\n    re.MULTILINE\n)\n\ndef _normalize_math_answer(value) -> str:\n    \"\"\"\n    Aggressively cleans math answers:\n    1. Converts to string.\n    2. Removes '$', ',', and spaces.\n    3. Removes trailing '.0' (common Pandas issue where ints become floats).\n    \"\"\"\n    if value is None:\n        return \"\"\n    \n    # Convert to string and lower case\n    val = str(value).strip().lower()\n    \n    # Remove Currency and Commas\n    val = val.replace(\"$\", \"\").replace(\",\", \"\")\n    \n    # Remove trailing .0 (e.g., \"150.0\" -> \"150\")\n    if val.endswith(\".0\"):\n        val = val[:-2]\n        \n    return val.strip()\n\n# Loose: Just looks for the tags existence anywhere\ndef calculate_soft_format_score(text):\n    score = 0.0\n    # Check for existence of tags (Partial credit)\n    if \"<reasoning>\" in text: score += 0.05\n    if \"</reasoning>\" in text: score += 0.05\n    if \"<answer>\" in text: score += 0.05\n    if \"</answer>\" in text: score += 0.05\n    \n    # Check for strict adherence (Bonus to reach 0.3 total)\n    if strict_format_pattern.search(text.strip()):\n        score = 0.3 # Max format score\n    return min(score, 0.3)\n\ndef robust_extract_answer(text):\n    \"\"\"\n    Try to extract content from tags. \n    If tags are missing, return the full text so we can search for the answer inside it.\n    \"\"\"\n    # 1. Try strict <answer> tags\n    match = re.search(r\"<answer>(.*?)</answer>\", text, re.DOTALL)\n    if match:\n        return match.group(1).strip()\n    \n    # 2. GSM8K style fallback\n    if \"####\" in text:\n        return text.split(\"####\")[-1].strip()\n    \n    # 3. FALLBACK: Return the whole text (or the last 200 chars) \n    # This allows the accuracy checker to find the answer even if tags are missing.\n    return text.strip()\n\n\ndef robust_extract_code(text):\n    \"\"\"Extract code from within tags, or markdown, or raw.\"\"\"\n    # 1. Try inside <answer> tags\n    match = re.search(r\"<answer>(.*?)</answer>\", text, re.DOTALL)\n    content = match.group(1).strip() if match else text \n\n    # 2. Clean Markdown (```python ... ```)\n    code_match = re.search(r\"```(?:\\w+)?\\s*(.*?)\\s*```\", content, re.DOTALL)\n    if code_match:\n        return code_match.group(1).strip()\n    \n    # 3. If no markdown, assume the whole content of answer is code\n    return content.strip()","metadata":{"_uuid":"71524a1f-4dc0-499b-88f9-78b0569c35e1","_cell_guid":"d3aed465-b257-4cee-a2b4-a32d63005b17","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T17:56:44.814307Z","iopub.execute_input":"2026-01-10T17:56:44.814517Z","iopub.status.idle":"2026-01-10T17:56:44.820405Z","shell.execute_reply.started":"2026-01-10T17:56:44.814491Z","shell.execute_reply":"2026-01-10T17:56:44.819733Z"}},"outputs":[],"execution_count":142},{"cell_type":"code","source":"def check_code_quality_robust(completion, test_case):\n    \"\"\"\n    Returns a score from 0.0 to 0.7 based on compilation and tests.\n    \"\"\"\n    code = robust_extract_code(completion)\n    if not code:\n        return 0.0\n\n    score = 0.0\n    \n    # 1. Compilation Check (Worth 0.2)\n    try:\n        compile(code, '<string>', 'exec')\n        score += 0.2\n    except:\n        return 0.0 # If it doesn't compile, we can't run tests\n\n    # 2. Test Execution (Worth 0.5)\n    # Note: Assuming 'execute_multiple_codes_parallel' exists as per your original code\n    # If not, use simple exec logic. \n    try:\n        # Check if test_case is valid\n        if not test_case or test_case == \"nan\":\n            return score # Return just compilation score\n            \n\n        passed_fraction = 0.0 # Set this to result of your execution\n        \n        score += (0.5 * passed_fraction)\n    except:\n        pass\n        \n    return score\n\ndef check_math_accuracy_robust(completion, answer):\n    \"\"\"\n    Returns 0.7 if correct, 0.0 otherwise.\n    Robustly handles currency, floats, and surrounding text.\n    \"\"\"\n    # 1. Extract content from tags (or full text fallback)\n    pred_content = robust_extract_answer(completion)\n    \n    if not pred_content or not answer:\n        return 0.0\n\n    # 2. Normalize BOTH inputs using the new aggressive helper\n    # Model: \"<answer>$24</answer>\" -> \"$24\" -> \"24\"\n    pred_norm = _normalize_math_answer(pred_content)\n    \n    # GT: 24 (int) -> \"24\", or 24.0 (float) -> \"24\"\n    ans_norm = _normalize_math_answer(answer)\n\n    if not ans_norm:\n        return 0.0\n\n    # 3. CHECK: Is the Ground Truth inside the Prediction?\n    try:\n        # Exact match check first (most robust for pure numbers)\n        if ans_norm == pred_norm:\n            return 0.7\n            \n        # Regex Word Boundary check (prevents \"24\" matching \"124\")\n        pattern = rf\"\\b{re.escape(ans_norm)}\\b\"\n        if re.search(pattern, pred_norm):\n            return 0.7\n            \n        # Final Fallback: Simple substring (use carefully, good for \"24 boxes\")\n        if ans_norm in pred_norm:\n            return 0.7\n            \n    except Exception:\n        pass\n\n    return 0.0","metadata":{"_uuid":"dd9e4169-ebb5-4882-9b75-467b02ff6906","_cell_guid":"ad0737de-a158-4390-8faa-80b385a1decd","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T17:56:45.265854Z","iopub.execute_input":"2026-01-10T17:56:45.266047Z","iopub.status.idle":"2026-01-10T17:56:45.271694Z","shell.execute_reply.started":"2026-01-10T17:56:45.266030Z","shell.execute_reply":"2026-01-10T17:56:45.270927Z"}},"outputs":[],"execution_count":143},{"cell_type":"code","source":"def dispatch_reward(prompts, completions, domain, answer=None, **kwargs):\n    \"\"\"\n    Unified Reward Dispatcher.\n    \"\"\"\n    if domain is not None and not isinstance(domain, list): domain = [domain]\n    if answer is not None and not isinstance(answer, list): answer = [answer]\n\n    scores = []\n\n    for i, completion in enumerate(completions):\n        batch_idx = i // NUM_GENERATIONS\n\n        # 1. Extract and CLEAN Domain\n        d_raw = domain[batch_idx] if domain is not None and batch_idx < len(domain) else \"\"\n        \n        # FIX: Aggressive cleaning of the domain string\n        d = _to_scalar_str(d_raw).strip().lower()\n        \n        ans_raw = answer[batch_idx] if answer is not None and batch_idx < len(answer) else None\n        ans = _to_scalar_str(ans_raw)\n        \n        prompt_str = _to_scalar_str(prompts[batch_idx])\n        comp_text = _to_scalar_str(completion)\n\n        # 2. Calculate Scores\n        format_score = calculate_soft_format_score(comp_text)\n        accuracy_score = 0.0\n        \n        # --- LOGIC BRANCHING ---\n        # We explicitly check for common math variations\n        if \"coding\" in d:\n            reward_source = \"Coding\"\n            accuracy_score = check_code_quality_robust(comp_text, ans)\n            \n        elif \"math\" in d or \"gsm8k\" in d: # Added gsm8k just in case\n            reward_source = \"Math\"\n            accuracy_score = check_math_accuracy_robust(comp_text, ans)\n            \n        else:\n            reward_source = \"Unified\"\n            # Fallback for other domains\n            uni_rewards = unified_reward_func(\n                prompts=[prompt_str], completions=[comp_text], answer=[ans], domain=[d_raw]\n            )\n            total_score = uni_rewards[0] \n            # Back-calculate accuracy approx for logging\n            accuracy_score = max(0.0, total_score - format_score)\n\n        # 3. Final Summation (Only for specific domains, override Unified)\n        if reward_source in [\"Math\", \"Coding\"]:\n            total_score = min(1.0, format_score + accuracy_score)\n\n        scores.append(total_score)\n        \n        # DEBUG: Print the FIRST failure to help diagnosis\n        if i == 0 and total_score < 0.8 and accuracy_score > 0.6:\n             print(f\"⚠️ DEBUG: Domain='{d}' | Source={reward_source} | Calc: {format_score}+{accuracy_score}={total_score}\")\n\n    return scores","metadata":{"_uuid":"5203e54f-64ef-455c-9d4e-a6b4b6e62217","_cell_guid":"bb2768cc-96d1-4a44-9d8f-4783476ba76b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T17:56:53.189355Z","iopub.execute_input":"2026-01-10T17:56:53.189619Z","iopub.status.idle":"2026-01-10T17:56:53.196765Z","shell.execute_reply.started":"2026-01-10T17:56:53.189592Z","shell.execute_reply":"2026-01-10T17:56:53.195823Z"}},"outputs":[],"execution_count":144},{"cell_type":"code","source":"# Ckpt saving\ncheckpointing_options = ocp.CheckpointManagerOptions(\n    save_interval_steps=SAVE_INTERVAL_STEPS, max_to_keep=MAX_TO_KEEP\n)\n\n# Metrics logger\nmetrics_logging_options = metrics_logger.MetricsLoggerOptions(\n    log_dir=\"/tmp/content/tmp/tensorboard/grpo2\", flush_ever