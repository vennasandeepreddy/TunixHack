-9fba-d38763dee5c9","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-10T18:36:58.015808Z","iopub.execute_input":"2026-01-10T18:36:58.016009Z","iopub.status.idle":"2026-01-10T18:37:13.938832Z","shell.execute_reply.started":"2026-01-10T18:36:58.015992Z","shell.execute_reply":"2026-01-10T18:37:13.937465Z"},"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":18},{"cell_type":"markdown","source":"## 1. Grain Dataset","metadata":{"_uuid":"1ba02757-47f4-42ba-b59b-e357eef6bdb3","_cell_guid":"c9d72870-a25c-4e01-aeb9-4ef1a500f937","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def check_truncation_stats(data_list, name=\"Dataset\"):\n    truncated_count = 0\n    max_len_found = 0\n    lengths = []\n    print(f\"--- Analyzing {name} ---\")\n    for item in tqdm(data_list):\n        tokens = tokenizer.encode(item[\"text\"])\n        seq_len = len(tokens)\n        lengths.append(seq_len)\n        \n        if seq_len > max_len_found:\n            max_len_found = seq_len\n            \n        if seq_len > MAX_SEQ_LENGTH:\n            truncated_count += 1\n            \n    # Statistics\n    total = len(data_list)\n    percent = (truncated_count / total) * 100\n    \n    print(f\"\\nResults for {name}:\")\n    print(f\"✅ Total Samples: {total}\")\n    print(f\"⚠️ Truncated Samples: {truncated_count} ({percent:.2f}%)\")\n    print(f\"📏 Max Sequence Length Found: {max_len_found}\")\n    print(f\"🛑 Limit (MAX_SEQ_LENGTH): {MAX_SEQ_LENGTH}\")\n    \n    if truncated_count > 0:\n        print(f\"👉 You are losing data in {truncated_count} rows. Consider increasing MAX_SEQ_LENGTH if possible.\")\n    else:\n        print(\"🎉 No truncation! Your MAX_SEQ_LENGTH is safe.\")\n    print(\"=\"*40)\n\n# Run the check on both Train and Test\ncheck_truncation_stats(formatted_train_data, name=\"Training Data\")\ncheck_truncation_stats(formatted_test_data, name=\"Test Data\")","metadata":{"_uuid":"5385fd8d-8586-4ab8-a7cf-9b6534b82f07","_cell_guid":"6b7b2975-3332-4772-8173-10a5eff6c0d2","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T18:37:13.939588Z","iopub.execute_input":"2026-01-10T18:37:13.939751Z","iopub.status.idle":"2026-01-10T18:37:17.637326Z","shell.execute_reply.started":"2026-01-10T18:37:13.939737Z","shell.execute_reply":"2026-01-10T18:37:17.636243Z"}},"outputs":[{"name":"stdout","text":"--- Analyzing Training Data ---\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 3025/3025 [00:03<00:00, 846.77it/s]\n","output_type":"stream"},{"name":"stdout","text":"\nResults for Training Data:\n✅ Total Samples: 3025\n⚠️ Truncated Samples: 0 (0.00%)\n📏 Max Sequence Length Found: 2002\n🛑 Limit (MAX_SEQ_LENGTH): 2048\n🎉 No truncation! Your MAX_SEQ_LENGTH is safe.\n========================================\n--- Analyzing Test Data ---\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 94/94 [00:00<00:00, 818.17it/s]","output_type":"stream"},{"name":"stdout","text":"\nResults for Test Data:\n✅ Total Samples: 94\n⚠️ Truncated Samples: 0 (0.00%)\n📏 Max Sequence Length Found: 1643\n🛑 Limit (MAX_SEQ_LENGTH): 2048\n🎉 No truncation! Your MAX_SEQ_LENGTH is safe.\n========================================\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"}],"execution_count":19},{"cell_type":"code","source":"def tokenize_function(example):\n    full_text = example[\"text\"]\n    full_tokens = tokenizer.encode(full_text)\n    prompt_text = full_text.split(\"<start_of_turn>model\")[0] + \"<start_of_turn>model\\n\"\n    prompt_tokens = tokenizer.encode(prompt_text)\n    prompt_len = len(prompt_tokens)\n\n    # Padding/Truncation Logic\n    if len(full_tokens) > MAX_SEQ_LENGTH:\n        full_tokens = full_tokens[:MAX_SEQ_LENGTH]\n    else:\n        pad_token = tokenizer.pad_id() if hasattr(tokenizer, 'pad_id') else tokenizer.eos_id()\n        full_tokens = full_tokens + [pad_token] * (MAX_SEQ_LENGTH - len(full_tokens))\n\n    input_tokens = np.array(full_tokens, dtype=np.int32)\n    \n    # Create Mask\n    loss_mask = np.zeros_like(input_tokens, dtype=np.float32)\n    \n    # Enable loss only for the response part (ignoring padding)\n    seq_len = min(len(tokenizer.encode(full_text)), MAX_SEQ_LENGTH)\n    if seq_len > prompt_len:\n        loss_mask[prompt_len:seq_len] = 1.0\n\n    return TrainingInput(input_tokens=input_tokens, input_mask=loss_mask)","metadata":{"_uuid":"3a760029-80ce-4edb-9c6d-eaeb362fd851","_cell_guid":"a65ca471-1631-416a-a1f4-96d49822d02c","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T18:37:17.637708Z","iopub.execute_input":"2026-01-10T18:37:17.637873Z","iopub.status.idle":"2026-01-10T18:37:17.642530Z","shell.execute_reply.started":"2026-01-10T18:37:17.637858Z","shell.execute_reply":"2026-01-10T18:37:17.641704Z"}},"outputs":[],"execution_count":20},{"cell_type":"code","source":"train_grain = (\n    grain.MapDataset.source(formatted_train_data)\n    .map(tokenize_function)\n    .shuffle(seed=42)\n    .repeat(NUM_EPOCHS)\n    .batch(batch_size=TRAIN_MICRO_BATCH_SIZE, drop_remainder=True)\n)\n\neval_grain = (\n    grain.MapDataset.source(formatted_test_data)\n    .map(tokenize_function)\n    .batch(batch_size=TRAIN_MICRO_BATCH_SIZE, drop_remainder=True)\n)\n\nprint(\"Grain Datasets Ready.\")","metadata":{"_uuid":"e724824d-3e62-4a0a-9cb5-3bf9e8c7c73b","_cell_guid":"083e0f40-4dd8-4360-97e2-0c0d00aed95e","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-10T18:37:21.335921Z","iopub.execute_input":"2026-01-10T18:37:21.336174Z","iopub.status.idle":"2026-01-10T18:37:21.340658Z","shell.execute_reply.started":"2026-01-10T18:37:21.336157Z","shell.execute_reply":"2026-01-10T18:37:21.339572Z"}},"outputs":[{"name":"stdout","text":"Grain Datasets Ready.\n","output_type":"stream"}],"executio