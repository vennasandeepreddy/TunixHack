n  )\n\n  with grpo_mesh:\n    state = nnx.state(lora_model)\n    pspecs = nnx.get_partition_spec(state)\n    sharded_state = jax.lax.with_sharding_constraint(state, pspecs)\n    nnx.update(lora_model, sharded_state)\n\n  return lora_model","metadata":{"_uuid":"9e7d09de-b820-44ef-8d88-3e63c480e1d0","_cell_guid":"c18d7231-d80a-4e08-9d25-69e78d537b31","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-09T00:44:15.212617Z","iopub.execute_input":"2026-01-09T00:44:15.213005Z","iopub.status.idle":"2026-01-09T00:44:15.219824Z","shell.execute_reply.started":"2026-01-09T00:44:15.212985Z","shell.execute_reply":"2026-01-09T00:44:15.218818Z"}},"outputs":[],"execution_count":106},{"cell_type":"code","source":"trained_ckpt_path","metadata":{"_uuid":"fa93ea76-c8dc-472c-87b0-c7160e98d859","_cell_guid":"e3742675-e4f4-4860-ab1d-7f1dd4c707a8","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false},"execution":{"iopub.status.busy":"2026-01-09T00:44:17.504581Z","iopub.execute_input":"2026-01-09T00:44:17.505027Z","iopub.status.idle":"2026-01-09T00:44:17.509910Z","shell.execute_reply.started":"2026-01-09T00:44:17.505009Z","shell.execute_reply":"2026-01-09T00:44:17.509006Z"}},"outputs":[{"execution_count":107,"output_type":"execute_result","data":{"text/plain":"'/tmp/content/dpo/ckpts/389/model_params'"},"metadata":{}}],"execution_count":107},{"cell_type":"code","source":"# 1. Initialize Base Model (Load from disk ONCE)\nprint(\"Loading Base Model from disk...\")\nbase_model_ref, grpo_mesh, model_config = get_gemma_ref_model(\n    os.path.join(SFT_INTERMEDIATE_CKPT_DIR, \"state\")\n)\n\n# 2. Create a copy for the Policy Model (In-memory clone)\n# This avoids reading from disk again. \n# We split the model into graph definition and state, then merge them back to create a new independent object.\nprint(\"Cloning Base Model for Policy...\")\ngraph_def, params = nnx.split(base_model_ref)\nbase_model_policy = nnx.merge(graph_def, params)\n\n# 3. Apply LoRA to Reference Model\nprint(\"Applying LoRA to Reference Model...\")\nref_model = get_lora_model(base_model_ref, grpo_mesh=grpo_mesh)\n\n# 4. Apply LoRA to Policy Model\nprint(\"Applying LoRA to Policy Model...\")\nlora_policy = get_lora_model(base_model_policy, grpo_mesh=grpo_mesh)\n\nprint(\"✅ Base models initialized on GRPO Mesh.\")\n\n# 5. Load DPO Weights into BOTH models\ndpo_checkpoint_root = \"/tmp/content/dpo/ckpts\"\n\nif os.path.exists(dpo_checkpoint_root):\n    dpo_steps = [int(d) for d in os.listdir(dpo_checkpoint_root) if d.isdigit()]\n    if dpo_steps:\n        latest_dpo_step = max(dpo_steps)\n        trained_ckpt_path = os.path.join(dpo_checkpoint_root, str(latest_dpo_step), \"model_params\")\n\n        print(f\"Loading DPO checkpoint from: {trained_ckpt_path}\")\n        checkpointer = ocp.StandardCheckpointer()\n\n        # Create abstract params based on the NEW lora_policy structure (on GRPO Mesh)\n        abs_params = jax.tree.map(\n            lambda x: jax.ShapeDtypeStruct(x.shape, x.dtype),\n            nnx.state(lora_policy, nnx.LoRAParam),\n        )\n\n        # Restore (Auto-reshards from 8,1 -> 1,4)\n        dpo_lora_params = checkpointer.restore(trained_ckpt_path, target=abs_params)\n\n        # Update BOTH models\n        nnx.update(ref_model, dpo_lora_params)\n        nnx.update(lora_policy, dpo_lora_params)\n\n        print(\"✅ DPO weights loaded into both Reference and Policy models.\")\n    else:\n        print(\"⚠️ DPO checkpoint folder empty. Using SFT weights.\")\nelse:\n    print(\"⚠️ DPO checkpoint path not found. Using SFT weights.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-09T01:35:17.776244Z","iopub.execute_input":"2026-01-09T01:35:17.776520Z","iopub.status.idle":"2026-01-09T01:35:46.133816Z","shell.execute_reply.started":"2026-01-09T01:35:17.776504Z","shell.execute_reply":"2026-01-09T01:35:46.132664Z"}},"outputs":[{"name":"stdout","text":"Loading Base Model from