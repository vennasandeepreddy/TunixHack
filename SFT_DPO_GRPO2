y full model\nFULL_MODEL_DIR = \"/tmp/content/grpo2/full_model_export/\"\n\n# -----------------------------------------------------------------------------\n# 1. SAVE THE FULL MODEL STATE LOCALLY\n# -----------------------------------------------------------------------------\nprint(f\"💾 Saving full model state to {FULL_MODEL_DIR}...\")\nprint(\"This may take a minute as it is writing ~5GB to disk...\")\n\n# Ensure directory exists\nif os.path.exists(FULL_MODEL_DIR):\n    import shutil\n    shutil.rmtree(FULL_MODEL_DIR)\nos.makedirs(FULL_MODEL_DIR, exist_ok=True)\n\n# Save the entire state of lora_policy (Base Weights + LoRA Weights)\n# We use StandardCheckpointer to handle the sharded arrays\ncheckpointer = ocp.StandardCheckpointer()\ncheckpointer.save(\n    os.path.join(FULL_MODEL_DIR, \"model_params\"), \n    nnx.state(lora_policy)\n)\n\nprint(f\"✅ Full model saved locally at: {FULL_MODEL_DIR}\")\nprint(f\"   Size check:\")\n!du -sh {FULL_MODEL_DIR}\n\n# -----------------------------------------------------------------------------\n# 2. UPLOAD TO KAGGLE MODEL HUB\n# -----------------------------------------------------------------------------\n# We use a distinct handle for the full model\nfull_handle = f\"{KAGGLE_USERNAME}/{FULL_MODEL_SLUG}/flax/full-weights\"\n\nprint(f\"\\n🚀 Uploading FULL model to '{full_handle}'...\")\nprint(\"⚠️ NOTE: This is a large upload (~5GB). Do not close the tab.\")\n\ntry:\n    kagglehub.model_upload(\n        handle=full_handle,\n        local_model_dir=FULL_MODEL_DIR,\n        license_name=\"Apache 2.0\",\n        version_notes=\"Full Gemma2-2B + GRPO LoRA weights (unmerged state)\"\n    )\n    print(\"✅ Full Model uploaded successfully!\")\n    print(f\"🔗 View it here: https://www.kaggle.com/models/{full_handle}\")\nexcept Exception as e:\n    print(f\"❌ Upload failed: {e}\")","metadata":{"_uuid":"24bf7fd4-25f9-4902-af2b-6aa8dc685a37","_cell_guid":"a96222a5-9023-47b4-aa79-27809a00f427","trusted":true,"collapsed":false,"jupyter":{