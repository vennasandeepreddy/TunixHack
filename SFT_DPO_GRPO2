yplot as plt\nimport seaborn as sns\nimport pandas as pd\n\n# Define the log directory for GRPO\nlog_dir = \"/tmp/content/tmp/tensorboard/grpo2\"\ntry:\n    reader = SummaryReader(log_dir)\n    df = reader.scalars\n\n    # Pivot the data for easier plotting\n    df_pivot = df.pivot_table(index='step', columns='tag', values='value')\n\n    print(\"✅ Available Tags in Logs:\", df_pivot.columns.tolist())\n\n    plt.style.use('seaborn-v0_8-whitegrid')\n    fig, axes = plt.subplots(1, 3, figsize=(24, 6))\n    fig.suptitle('GRPO Training Metrics', fontsize=16)\n\n    # --- Plot 1: Mean Reward ---\n    # GOAL: Reward should generally go UP.\n    reward_cols = [c for c in ['train/rewards/mean', 'train/rewards/unified_reward_func'] if c in df_pivot.columns]\n    if reward_cols:\n        sns.lineplot(data=df_pivot[reward_cols], ax=axes[0])\n        axes[0].set_title('GRPO Mean Reward')\n        axes[0].set_ylabel('Reward')\n        axes[0].set_xlabel('Step')\n    else:\n        axes[0].set_title('Mean Reward tag not found')\n\n    # --- Plot 2: Actor Loss ---\n    # GOAL: Loss should go DOWN.\n    loss_cols = [c for c in ['actor/train/loss'] if c in df_pivot.columns]\n    if loss_cols:\n        sns.lineplot(data=df_pivot[loss_cols], ax=axes[1])\n        axes[1].set_title('Actor Loss')\n        axes[1].set_ylabel('Loss')\n        axes[1].set_xlabel('Step')\n    else:\n        axes[1].set_title('Actor Loss tag not found')\n\n    # --- Plot 3: KL Divergence ---\n    # GOAL: Should remain low and stable, not grow uncontrollably.\n    kl_cols = [c for c in ['actor/train/kl'] if c in df_pivot.columns]\n    if kl_cols:\n        sns.lineplot(data=df_pivot[kl_cols], ax=axes[2])\n        axes[2].set_title('KL Divergence')\n        axes[2].set_ylabel('KL')\n        axes[2].set_xlabel('Step')\n    else:\n        axes[2].set_title('KL Divergence tag not found')\n\n    plt.tight_layout(rect=[0, 0, 1, 0.96])\n    plt.show()\n\nexcept (FileNotFoundError, ValueError) as e:\n    print(f\"Could not read TensorBoard logs. Please ensure training has run and logs exist in '{log_dir}'.\")\n    print(f\"Error: {e}\")","metadata":{"_uuid":"3b231c34-ae51-49a3-b330-d834afb57e9b","_cell_guid":"f913021d-7af4-4207-9712-ee67bc156077","trusted":true,"collapsed":false,"execution":{"iopub.status.busy":"2026-01-07T23:32:38.770349Z","iopub.execute_input":"2026-01-07T23:32:38.770658Z","iopub.status.idle":"2026-01-07T23:32:42.169262Z","shell.execute_reply.started":"2026-01-07T23:32:38.770640Z","shell.execute_reply":"2026-01-07T23:32:42.168369Z"},"jupyter":{"outputs_hidden":false}},"outputs":[{"name":"stdout","text":"✅ Available Tags in Logs: ['actor/train/kl', 'actor/train/loss', 'actor/train/perplexity', 'actor/train/step_time_sec', 'actor/train/steps_per_sec', 'actor/train/tflops_per_step', 'jax/core/compile/backend_compile_duration', 'jax/core/compile/jaxpr_to_mlir_module_duration', 'jax/core/compile/jaxpr_trace_duration', 'jax/orbax/write/replicated_array_gb', 'jax/orbax/write/sharded_array_gb', 'train/completions/max_length', 'train/completions/mean_length', 'train/completions/min_length', 'train/rewards/max', 'train/rewards/min', 'train/rewards/sum', 'train/rewards/unified_reward_func']\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2400x600 with 3 Axes>","image/png":""},"metadata":{}}],"execution_count":52},{"cell_type":"markdown","source":"## 3. Checkpointing","metadata":{"_uuid":"678c8a3a-ed07-42f5-b07b-9554a7f06c2c","_cell_guid":"96443934-a2e4-4cd5-b93c-e5852aba8640","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"# Find the latest GRPO checkpoint\ncheckpoint_root = \"/tmp/content/grpo2/ckpts/\"\nsteps = [int(d) for d in os.listdir(checkpoint_root) if d.isdigit()]\n\nif not steps:\n    print(\"No GRPO checkpoints found.\")\nelse:\n    latest_step = max(steps)\n    trained_ckpt_path = os.path.join(checkpoint_root, str(latest_step), \"actor\")\n    \n    print(f\"✅ Latest GRPO checkpoint found: Step {latest_step}\")\n    print(f\"📂 Path: {trained_ckpt_path}\")\n\n    # Load the trained GRPO weights into the policy model\n    abs_params = jax.tree.map(\n        lambda x: jax.ShapeDtypeStruct(x.shape, x.dtype),\n        nnx.state(lora_policy, nnx.LoRAParam),\n    )\n    checkpointer = ocp.StandardCheckpointer()\n    trained_grpo_params = checkpointer.restore(trained_ckpt_path, target=abs_params)\n\n    nnx.update(lora_policy, trained_grpo_params)\n\n    print(\"✅ Successfully updated lora_policy with final GRPO weights!\")","metadata":{"_uuid":"1add689c-0943-4890-b7ea-299776c031db","_cell_guid":"c8e3da81-a246-4c9f-ad9a-119122190657","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Define the path for the final GRPO LoRA checkpoint\nGRPO_LORA_CKPT_DIR = \"/tmp/content/grpo2/lora_final/\"\nos.makedirs(GRPO_LORA_CKPT_DIR, exist_ok=True)\n\n# Extract only the LoRA parameters from the GRPO-trained model\ngrpo_lora_params = nnx.state(lora_policy, nnx.LoRAParam)\n\n# Save the LoRA parameters\ncheckpointer = ocp.PyTreeCheckpointer()\ncheckpointer.save(os.path.join(GRPO_LORA_CKPT_DIR, \"model_params\"), grpo_lora_params)\n\nprint(f\"✅ GRPO LoRA parameters saved to: {GRPO_LORA_CKPT_DIR}\")\n!ls -l {GRPO_LORA_CKPT_DIR}","metadata":{"_uuid":"c5f65bd4-496f-4957-aebb-95f04b3f562a","_cell_guid":"a31b1381-3db4-48cf-ae3a-d7a6c2f47c5a","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Zip the final GRPO checkpoint for download\n!zip -r grpo_lora_checkpoint.zip {GRPO_LORA_CKPT_DIR}\n\nimport shutil\nshutil.make_archive('/kaggle/working/grpo_lora_checkpoint', 'zip', GRPO_LORA_CKPT_DIR)","metadata":{"_uuid":"ffd0935a-6539-426a-bcaa-e7a5c535b44c","_cell_guid":"b33f674e-9544-47b7-81ce-ec6642faa576","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Post Training","metadata":{"_uuid":"ca3ebf6f-0b9a-4b64-add7-b783b88a0d1b","_cell_guid":"8634dec0-e6d8-4f73-ad76-1f46f93ea503","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"sampler = sampler_lib.Sampler(\n    transformer=lora_policy,\n    tokenizer=tokenizer,\n    cache_config=sampler_lib.CacheConfig(\n        cache_size=MAX_PROMPT_LENGTH + TOTAL_GENERATION_STEPS + 256,\n        num_layers=model_config.num_layers,\n        num_kv_heads=model_config.num_kv_heads,\n        head_dim=model_config.head_dim,\n    ),\n)\n\n\nif wandb.run is not None:\n    wandb.finish()\n\n\nwandb.init(project=\"tunix-grpo2-demo\", name=f\"GRPO_{NUM_EPOCHS}_epoch_{wandb_name}\")\n\n## Pre-Training Evaluation\npre_train_prompts = test_df['Question'].tolist()\npre_train_answers = test_df['Answer'].tolist()\npre_train_domains = test_df['Domain'].tolist()\n\ninf_batch_size = 4\npre_train_results = []\n\nfor i in tqdm(range(0, len(pre_train_prompts), inf_batch_size)):\n    batch_prompts = pre_train_prompts[i : i + inf_batch_size]\n    batch_output = generate(batch_prompts, sampler)\n    pre_train_results.extend(batch_output)\n\npre_train_rewards = unified_reward_func(\n    prompts=pre_train_prompts,\n    completions=pre_train_results,\n    answer=pre_train_answers,\n    domain=pre_train_domains\n)\n\navg_pre_train_reward = sum(pre_train_rewards) / len(pre_train_rewards)\nprint(f\"Average pre-training reward: {avg_pre_train_reward}\")\n\ntest_df['GRPO2_Pre_Training_Output'] = pre_train_results\ntest_df['GRPO2_Pre_Training_Reward'] = pre_train_rewards","metadata":{"_uuid":"ab95bac3-1641-4555-a9b4-2e61a3e4371f","_cell_guid":"a7a66fd5-af7c-4a84-97df-39c3e2980a1f","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"test_df.to_excel('./GRPO2_trained_results.xlsx')","metadata":{"_uuid":"f2565074-17e1-45ff-b