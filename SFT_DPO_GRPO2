"816acff2-5c3c-4d16-b499-2c52ae9375d2","_cell_guid":"401772e0-1464-4faa-a077-37b69d627cb7","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import sys\nimport random\n\n# --- LOGGING CONFIGURATION ---\n# Probability of printing a row (0.05 = ~5% of samples). \n# Adjust to 1.0 if you want to see EVERYTHING (warning: very verbose), \n# or 0.01 for a light sampling.\nDEBUG_PRINT_RATE = 0.1 \n\n# Helper to robustly convert JAX/Numpy/Bytes to Python Strings\ndef _to_scalar_str(x) -> str:\n    if x is None: return \"\"\n    if hasattr(x, \"ndim\"): # checks for numpy/jax array\n        if x.ndim == 0: x = x.item()\n        elif x.size == 1: x = x.reshape(()).item()\n        else:\n            x0 = x.reshape(-1)[0]\n            x = x0.item() if hasattr(x0, \"item\") else x0\n    if hasattr(x, \"item\") and not isinstance(x, (str, bytes, bytearray)):\n        try: x = x.item()\n        except: pass\n    if isinstance(x, (bytes, bytearray)):\n        return x.decode(\"utf-8\", errors=\"ignore\")\n    return str(x)","metadata":{"_uuid":"2b2b42cc-3a0e-4cda-9a38-4402292d399b","_cell_guid":"e67146cb-cfa2-4dd9-8da2-38ce7714c03e","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import re\nimport math\n\n# Global flag for debug\nDEBUG_ONCE = True\n\ndef unified_reward_func(prompts, completions, answer, domain, **kwargs):\n    \"\"\"\n    Reward Breakdown (Max 1.0):\n    1. Format (0.4): Strict XML tags.\n    2. Accuracy (0.4): Correct answer found INSIDE tags.\n    3. Reasoning (0.1): Structure, Length, Logic, Convergence.\n    4. Bonus (0.1): \"Trifecta\" -> Perfect Format + Accuracy + High Quality Reasoning.\n    \"\"\"\n    global DEBUG_ONCE\n    rewards = []\n\n    # Regex definitions\n    strict_structure_pattern = r'^<reasoning>[\\s\\S]*?</reasoning>\\s*<answer>[\\s\\S]*?</answer>(?:\\s*<end_of_turn>)?$'\n    extraction_pattern = r\"<reasoning>\\s*(.*?)\\s*</reasoning>\\s*<answer>\\s*(.*?)\\s*</answer>\"\n\n    # GRPO: completions has batch_size * NUM_GENERATIONS items, while answer/domain are batch_size.\n    # So we score each completion and map back to its prompt via i // NUM_GENERATIONS.\n    # NOTE: wrap scalars as singletons; do NOT use list(x) (strings become list of chars).\n    if answer is not None and not isinstance(answer, list):\n        answer = [answer]\n    if domain is not None and not isinstance(domain, list):\n        domain = [domain]\n\n    for i, content in enumerate(completions):\n        batch_idx = i // NUM_GENERATIONS\n        gt_ans = answer[batch_idx] if answer is not None and batch_idx < len(answer) else \"\"\n        dom = domain[batch_idx] if domain is not None and batch_idx < len(domain) else \"\"\n\n        # Handle Flax/Tunix passing lists or strings\n        completion_text = content[0]['content'] if isinstance(content, list) else content\n        completion_text_norm = completion_text.strip()\n\n        if DEBUG_ONCE and i == 0:\n            print(f\"\\n[DEBUG] Domain: {dom} | GT: {gt_ans}\")\n            print(f\"[DEBUG] Model Out: {completion_text_norm[:100]}...\")\n            DEBUG_ONCE = False\n\n        # Init scores\n        score_format = 0.0\n        score_accuracy = 0.0\n        score_reasoning = 0.0\n        score_bonus = 0.0\n\n        # =========================================================\n        # 1. FORMAT SCORE (Max 0.4)\n        # =========================================================\n        if re.search(strict_structure_pattern, completion_text_norm, re.IGNORECASE):\n            score_format = 0.4\n        else:\n            # Partial credit (max 0.2)\n            if '<reasoning>' in completion_text_norm: score_format += 0.05\n            if '</reasoning>' in completion_text_norm: score_format += 0.05\n            if '<answer>' in completion_text_norm: score_format += 0.05\n            if '</answer>' in completion_text_norm: score_format += 0.05\n            score_format = min(score_format, 0.2)\n\n        # =========================================================\n        # 2. ATTEMPT EXTRACTION\n        # =========================================================\n        match = re.search(extraction_pattern, completion_text_norm, flags=re.DOTALL | re.IGNORECASE)\n        reasoning_content = match.group(1).strip() if match else \"\"\n        extracted_model_answer = match.group(2).strip() if match else None\n\n        # =========================================================\n        # 3. ACCURACY SCORE (Max 0.4)\n        # =========================================================\n        if extracted_model_answer and gt_ans:\n            model_val = extracted_model_answer.lower().strip().rstrip(\".,;!\")\n            gt_val = str(gt_ans).strip()\n            gt_val_clean = re.sub(r'\\.$', '', gt_val).lower()\n\n            try:\n                is_correct = False\n                # Domain Logic\n                if dom in ['W6', 'PZ1', 'PZ2', 'CS4']:\n                    if model_val == gt_val_clean: is_correct = True\n                elif dom in ['FP1', 'FP2', 'CS1', 'CS2', 'CS3']:\n                    target_num, target_text = \"\", \"\"\n                    if '_' in gt_val_clean:\n                        parts = gt_val_clean.split('_', 1)\n                        target_num, target_text = parts[0].strip(), parts[1].strip()\n                    else:\n                        target_text = gt_val_clean\n                    num_match = target_num and re.search(rf\"\\b{re.escape(target_num)}\\b\", model_val)\n                    text_match = target_text and (target_text in model_val)\n                    if num_match or text_match: is_correct = True\n                else:\n                    if re.search(rf\"\\b{re.escape(gt_val_clean)}\\b\", model_val): is_correct = True\n\n                if is_correct: score_accuracy = 0.4\n            except Exception:\n                score_accuracy = 0.0\n\n        # =========================================================\n        # 4. REASONING SCORE (Max 0.1)\n        # =========================================================\n        if reasoning_content:\n            words = reasoning_content.split()\n            count = len(words)\n\n            # --- GATE: REPETITION CHECK ---\n            unique_ratio = len(set(words)) / count if count > 0 else 0\n\n            if unique_ratio < 0.3 or count < 10:\n                score_reasoning = 0.0\n            else:\n                # A. BASE LENGTH (Max 0.02)\n                if count < 40:\n                    r_len = 0.02 * (count / 40.0)\n                elif count <= 600:\n                    r_len = 0.02\n                else:\n                    excess = (count - 600) / 1000.0\n                    r_len = max(0.0, 0.02 - excess)\n\n                # B. STRUCTURE CHECK (Max 0.03)\n                r_structure = 0.0\n                if reasoning_content.count('\\n') >= 2:\n                    r_structure += 0.01\n                if re.search(r'(\\n\\d+\\.|\\n-\\s|\\bStep\\s\\d)', reasoning_content):\n                    r_structure += 0.02\n                r_structure = min(r_structure, 0.03)\n\n                # C. LOGICAL FLOW CHECK (Max 0.02)\n                r_flow = 0.0\n                connectors = ['therefore', 'because', 'since', 'implies', 'thus', 'so', 'consequently']\n                found_connectors = sum(1 for c in connectors if c in reasoning_content.lower())\n                if found_connectors >= 2:\n                    r_flow = 0.02\n                elif found_connectors == 1:\n                    r_flow = 0.01\n\n                # D. CONVERGENCE CHECK (Max 0.03)\n                r_conv = 0.0\n                if extracted_model_answer:\n                    tail_segment = reasoning_content[-300:].lower()\n                    ans_val = extracted_model_answer.lower().strip()\n                    if ans_val in tail_segment:\n                        r_conv = 0.03\n\n                score_reasoning = min(r_len + r_structure + r_flow + r_conv, 0.1)\n\n        # =========================================================\n        # 5. BONUS SCORE (Max 0.1)\n        # THE TRIFECTA: Perfect Format + Perfect Accuracy + Good Reasoning\n        # =========================================================\n        # Threshold 0.08 ensures the model got 80% of reasoning points\n        # (meaning it likely had good length + structure + convergence)\n        if score_format == 0.4 and score_accuracy == 0.4 and score_reasoning >= 0.08:\n            score_bonus = 0.1\n\n        # =========================================================\n        # FINAL SUM\n        # =========================================================\n        total_score = score_format + score_accuracy + score_bonus + score_reasoning\n        rewards.append(total_score)\n\n    return rewards","metadata":{"_uuid":"3f9f58c5-12aa-475a-9239-7c0b58840997","_cell_guid":"267a9f41-b6de-4d2f-954d-6f21dd33f8d5","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"reasoning_start, reasoning_end = \"<reasoning>\", \"</reasoning>\"\nanswer_start, answer_end = \"<answer>\", \"</answer>\"","metadata":{"_uuid":"fbc0b802-1994-4ec8-8fe8-75792af2d255","_cell_guid":"1f53e57c-fdd0-47a4-bb63-2640f13544ed","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import re\n\n# 1. Define Regex Patterns (Strict and Loose)\n# Strict: Enforces structure exactness\nstrict_format_pattern = re.compile(\n    r\"^<reasoning>[\\s\\S]*?</reasoning>\\s*<answer>[\\s\\S]*?</answer>(?:\\s*<end_of_turn>)?$\",\n    re.MULTILINE\n)\n\ndef _normalize_math_answer(value) -> str:\n    \"\"\"\n    Aggressively cleans math answers:\n    1. Converts to string.\n    2. Removes '$', ',', and spaces.\n    3. Removes trailing '.0' (common Pandas issue where ints become floats).\n    \"\"\"\n    if value is None:\n        return \"\"\n    \n    # Convert to string and lower case\n    val = str(value).strip().lower()\n    \n    # Remove Currency and Commas\n    val = val.replace(\"$\", \"\").replace(\",\", \"\")\n    \n    # Remove trailing .0 (e.g., \"150.0\" -> \"150\")\n    if val.endswith(\".0\"):\n        val = val[:-2]\n        \n    return val.strip()\n\n# Loose: Just looks for the tags existence anywhere\ndef calculate_soft_format_score(text):\n    score = 0.0\n    # Check for existence of tags (Partial credit)\n    if \"<reasoning>\" in text: score += 0.05\n    if \"</reasoning>\" in text: score += 0.05\n    if \"<answer>\" in text: score += 0.05\n    if \"</answer>\" in text: score += 0.05\n    \n    # Check for strict adherence (Bonus to reach 0.3 total)\n    if strict_format_pattern.search(text.strip()):\n        score = 0.3 # Max format score\n    return min(score, 0.3)\n\ndef robust_extract_answer(text):\n    \"\"\"\n    Try to extract content from tags. \n    If tags are missing, return the full text so we can search for the answer inside it.\n    \"\"\"\n    # 1. Try strict <answer> tags\n    match = re.search(r\"<answer>(.*?)</answer>\", text, re.DOTALL)\n    if match:\n        return match.group(1).strip()\n    \n    # 2. GSM8K style fallback\n    if \"####\" in text:\n        return text.split(\"####\")[-1].strip()\n    \n    # 3. FALLBACK: Return the whole text (or the last 200 chars) \n    # This allows the accuracy checker to find the answer even if tags are missing.\n    return text.strip()\n\n\ndef robust_extract_code(text):\n    \"\"\"Extract code from within tags, or markdown, or raw.\"\"\"\n    # 1. Try inside <answer> tags\n    match = re.search(r\"<answer>(.*?)</answer>\", text, re.DOTALL)\n    content = match.group(1).strip() if match else text \n\n    # 2. Clean Markdown (```python ... ```)\n    code_match = re.search(r\"```(?:\\w+)?\\s*(.*?)\\s*```\", content, re.DOTALL)\n    if code_match:\n        return code_match.group(1).strip()\n    \n    # 3. If no markdown, assume the whole content of answer is code\n    return content.strip()","metadata":{"_uuid":"71524a1f-4dc0-499b-88f9-78b0569c35e1","_cell_guid":"d3aed465-b257-4cee-a2b4-a32d63005b17","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def check_code_quality_robust(completion, test_case):\n    \"\"\"\n    Returns a score from 0.0 to 0.7 based on compilation and tests.\n    \"\"\"\n    code = robust_extract_code(completion)\n    if not code:\n        return 0.0\n\n    score = 0.0\n    \n    # 1. Compilation Check (Worth 0.2)\n    try:\n        compile(code, '<string>', 'exec')\n        score += 0.2\n    except:\n        return 0.0 # If it doesn't compile, we can't run tests\n\n    # 2. Test Execution (Worth 0.5)\n    # Note: Assuming 'execute_multiple_codes_parallel' exists as per your original code\n    # If not, use simple exec logic. \n    try:\n        # Check if test_case is valid\n        if not test_case or test_case == \"nan\":\n            return score # Return just compilation score\n            \n\n        passed_fraction = 0.0 # Set this to result of your execution\n        \n        score += (0.5 * passed_fraction)\n    except:\n        pass\n        \n    return score\n\ndef check_math_accuracy_robust(completion, answer):\n    \"\"\"\n    Returns 0.7 if correct, 0.0 otherwise.\n    Robustly handles currency, floats, and surrounding text.\n    \"\"\"\n    # 1. Extract content from tags (or full text fallback)\n    pred_content = robust_extract_answer(completion)\n    \n    if not pred_content or not answer:\n        return 0.0\n\n    # 2. Normalize BOTH inputs using the new aggressive helper\n    # Model: \"<answer>$24</answer>\" -> \"$24\" -> \"24\"\n    pred_norm = _normalize_math_answer(pred_content)\n    \n    # GT: 24 (int) -> \"24\", or 24.0 (float) -> \"24\"\n    ans_norm = _normalize_math_answer(answer)\n\n    if not ans_norm:\n        return 0.0\n\n    # 3. CHECK: Is the Ground Truth inside the Prediction?\n    try:\n        # Exact match check first (most robust for pure numbers)\n        if ans_norm == pred_norm:\n            return 0.7\n            \n        # Regex Word Boundary check (prevents \"24\" matching \"124\")\n        pattern = rf\"\\b{re.escape(ans_norm)}\\b\"\n        if re.search(pattern, pred_norm):\n            return 0.7\n            \n        # Final Fallback: Simple substring (use carefully, good for \"24 boxes\")\n        if ans_norm in pred_norm:\n            return 0.7\n            \n    except Exception:\n        pass\n\n    return 0.0","metadata":{"_uuid":"dd9e4169-ebb5-4882-9b75-467b02ff6906","_cell_guid":"ad0737de-a158-4390-8faa-80b385a1decd","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def dispatch_reward(prompts, completions, domain, answer=None, **kwargs):\n    \"\"\"\n    Unified Reward Dispatcher.\n    \"\"\"\n    if domain is not None and not isinstance(domain, list): domain = [domain]\n    if answer is not None and not isinstance(answer, list): answer = [answer]\n\n    scores = []\n\n    for i, completion in enumerate(completions):\n        batch_idx = i // NUM_GENERATIONS\n\n        # 1. Extract and CLEAN Domain\n        d_raw = domain[batch_idx] if domain is not None and batch_idx < len(domain) else \"\"\n        \n        # FIX: Aggressive cleaning of the domain string\n        d = _to_scalar_str(d_raw).strip().lower()\n        \n        ans_raw = answer[batch_idx] if answer is not None and batch_idx < len(answer) else None\n        ans = _to_scalar_str(ans_raw)\n        \n        prompt_str = _to_scalar_str(prompts[batch_idx])\n        comp_text = _to_scalar_str(completion)\n\n        # 2. Calculate Scores\n        format_score = calculate_soft_format_score(comp_text)\n        accuracy_score = 0.0\n        \n        # --- LOGIC BRANCHING ---\n        # We explicitly check for common math variations\n        if \"coding\" in d:\n            reward_source = \"Coding\"\n            accuracy_score = check_code_quality_robust(comp_text, ans)\n            \n        elif \"math\" in d or \"gsm8k\" in d: # Added gsm8k just in case\n            reward_source = \"Math\"\n            accuracy_score = check_math_accuracy_robust(comp_text, ans)\n            \n        else:\n            reward_source = \"Unified\"\n            # Fallback for other domains\n            uni_rewards = unified_reward_func(\n                prompts=[prompt_str], completions=[comp_text], answer=[ans], domain=[d_raw]\n            )\n            total_score = uni_rewards[0] \n            # Back-calculate accuracy approx for logging\n            accuracy_score = max(0.0, total_score - format_score)\n\n        # 3. Final Summation (Only for specific domains, override Unified)\n        if reward_source in [\"Math\", \"Coding\"]:\n            total_score = min(1.0, format_score + accuracy_score)\n\n        scores.append(total_score)\n        \n        # DEBUG: Print the FIRST failure to help diagnosis\n        if i == 0 and total_score < 0.8 and accuracy_score > 0.6:\n             print(f\"⚠️ DEBUG: Domain='{d}' | Source={reward_source} | Calc: {format_score}+{accuracy_score}={total_score}\")\n\n    return scores","metadata":{"_uuid":"5203e54f-64ef-455c-9d4e-a6b4b6e62217","_cell_guid":"bb2768cc-96d1-4a44-9d8f-4783476ba76b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"_uuid":"ed507cc1-c89b-448b-85a1-b042919197e6","_cell_guid":"df0eba6d-1242-4f54-9e6d-bb62644733e0","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Pre-training","metadata":{"_uuid":"80a3543e-474c-4518-b1ab-d9946d8afdf5","_cell_guid":"284d7950-04ba-4d63-a3f7-42e3d9eb31d9","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"def generate(question, sampler, temperature=0.7, top_k=50, top_p=0.95, seed=None):\n  if isinstance(question, str):\n    input_batch = [\n        BASE_SYSTEM_PROMPT.format(task = question),\n    ]\n  else:\n    input_batch = [\n        BASE_SYSTEM_PROMPT.format(          \n            task=q,\n        )\n        for q in question\n    ]\n\n  out_data = sampler(\n      input_strings=input_batch,\n      max_generation_steps=768,\n      temperature=temperature,\n      top_k=top_k,\n      top_p=top_p,\n      echo=False,\n      seed=seed if seed is not None else None,\n      eos_tokens=[1,106],\n  )\n\n  output = out_data.text\n  if isinstance(question, str):\n    return output[0]\n  return output","metadata":{"_uuid":"20ae511f-9954-45c2-a9f4-848c7bdab071","_cell_guid":"65969a3c-88c7-4d77-a543-948cd35d92c1","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"sampler = sampler_lib.Sampler(\n    transformer=lora_policy,\n    tokenizer=tokenizer,\n    cache_config=sampler_lib.CacheConfig(\n        cache_size=MAX_PROMPT_LENGTH + TOTAL_GENERATION_STEPS + 256,\n        num_layers=model_config.num_layers,\n        num_kv_heads=model_config.num_kv_heads,\n        head_dim=model_config.head_dim,\n    ),\n)","metadata":{"_uuid":"e782f974-b3e7-469a-a5f7-dd5003c059e0","_cell_guid":"af254d29-9c1e-4447-a627-514d20364802","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"if wandb.run is not None:\n    wandb.finish()\n\n\nwandb.init(project=\"tunix-grpo2-demo\", name=f\"GRPO_{NUM_EPOCHS}_epoch_{wandb_name}\")","metadata":{"_uuid":"904b459c-1860-4213-aabf-d335d73beb2c","_cell_guid":"60d51fd8-24ad-49dd-b574-ad3f051309c1","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"## Pre-Training Evaluation\npre_train_prompts = test_df['Question'].tolist()\npre_train_answers = test_df['Answer'].tolist()\npre_train_domains = test_df['Domain'].tolist()\n\ninf_batch_size = 4\npre_train_results = []\n\nfor i in tqdm(range(0, len(pre_train_prompts), inf_batch_size)):\n    batch_prompts = pre_train_prompts[i : i + inf_batch_size]\n    batch_output = generate(batch_prompts, sampler)\n    pre_train_results.extend(batch_output)\n\npre_train_rewards = dispatch_reward(\n    prompts=pre_train_prompts,\n    completions=pre_train_results,\n    answer=pre_train_answers,\n    domain=pre_train_domains\n)\n\navg_pre_train_reward = sum(pre_train_rewards) / len(pre_train_rewards)\nprint(f\"Average pre-training reward: {avg_pre_train_reward}\")\n\ntest_df['GRPO2_Pre_Training_Output'] = pre_train_results\ntest_df['GRPO2_Pre_Training_Reward'] = pre_train_rewards","metadata":{"_uuid":"e751ce0b-ce86-40a5-8b15-6b8d067723c0","_cell_guid":"cd5d2e34-5c2c-43b8-9e52-563a56510dd0","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"test_df.head()","metadata":{"_uuid":"51093b83-da2c-4232-a7aa-78030724176d","_cell_guid":"23205691-d288-4ccb-9152-1f379b0fa59d","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Model Training","metadata":{"_uuid":"f01e5c37-b708-4429-995e-0c657260693d","_cell_guid":"170ae12e-a662-4c21-a5f6-f2d02c7300c9","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"ls -ltr /tmp/content/sft/intermediate_ckpt/state","metadata":{"_uuid":"3be3bc6c-6adf-465d-9790-53f0dddd55c8","_cell_guid":"bc283620-1a5c-4a2a-9141-4a5106377194","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"","metadata":{"_uuid":"96693390-3fb3-4749-9709-bb431f13c92d","_cell_guid":"22d7e959-d41b-4533-bca9-d5b02a620080","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from tbparse import SummaryReader\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport pandas as pd\n\n# Define the log directory for GRPO\nlog_dir = \"/tmp/content/tmp/tensorboard/grpo2\"\ntry:\n    reader = SummaryReader(log_dir)\n    df = reader.scalars\n\n    # Pivot the data for easier plotting\n    df_pivot = df.pivot_table(index='step', columns='tag', values='value')\n\n    print(\"✅ Available Tags in Logs:\", df_pivot.columns.tolist())\n\n    plt.style.use('seaborn-v0_8-whitegrid')\n    fig, axes = plt.subplots(1, 3, figsize=(24, 6))\n    fig.suptitle('GRPO Training Metrics', fontsize=16)\n\n    # --- Plot 1: Mean Reward ---\n    # GOAL: Reward should generally go UP.\n    reward_cols = [c for c in ['train/rewards/mean', 'train/rewards/dispatch_reward'] if c in df_pivot.columns]\n    if reward_cols:\n        sns.lineplot(data=df_pivot[reward_cols], ax=axes[0])\n        axes[0].set_title('GRPO Mean Reward')\n        axes[0].set_ylabel('Reward')\n        axes[0].set_xlabel('Step')\n    else:\n        axes[0].set_title('Mean Reward tag not found')\n\n    # --- Plot 2: Actor Loss ---\n    # GOAL: Loss should go DOWN.\n    loss_cols = [c for c in ['actor/train/loss'] if c in df_pivot.columns]\n    if loss_cols:\n        sns.lineplot(data=df_pivot[loss_cols], ax=axes[1])\n        axes[1].set_title('Actor Loss')\n        axes[1].set_ylabel('Loss')\n        axes[1].set_xlabel('Step')\n    else:\n        axes[1].set_title('Actor Loss tag not found')\n\n    # --- Plot 3: KL Divergence ---\n    # GOAL: Should remain low and stable, not grow uncontrollably.\n    kl_cols = [c for c in ['actor/train/kl'] if c in df_pivot.columns]\n    if kl_cols:\n        sns.lineplot(data=df_pivot[kl_cols], ax=axes[2])\n        axes[2].set_title('KL Divergence')\n        axes[2].set_ylabel('KL')\n        axes[2].set_xlabel('Step')\n    else:\n        axes[2].set_title('KL Divergence tag not found')\n\n    plt.tight_layout(rect=[0, 0, 1, 0.96])\n    plt.show()\n\nexcept (FileNotFoundError, ValueError) as e:\n    print(f\"Could not read TensorBoard logs. Please ensure training has run and logs exist in '{log_dir}'.\")\n    print(f\"Error: {e}\")","metadata":{"_uuid":"16d6a5b9-3eee-442c-98e5-65264490004b","_cell_guid":"3b58958c-49b8-4fd6-99c4-49349dd380fe","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"[[](http://)](http://)","metadata":{}},{"cell_type":"markdown","source":"## 3. Checkpointing","metadata":{"_uuid":"52c2a03e-e5c3-4769-b34c-b214c445e697","_cell_guid":"ffa00013-6b6a-4e8e-8a6d-4511d6fc8151","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}}},{"cell_type":"code","source":"INTERMEDIATE_CKPT_DIR = \"/tmp/content/grpo2/intermediate_ckpt/\"\nCKPT_DIR = \"/tmp/content/grpo2/ckpts/\"","metadata":{"_uuid":"ce85a029-80c5-42e0-ab96-6a19dddbba49","_cell_guid":"6ffdd169-89be-4806-9b65-48801831f7bd","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"ls -ltr /tmp/content/grpo2/ckpts/actor/1497","metadata":{"_uuid":"17e7f36c-8b9f-40cf-8d39-e50f369e6a4a","_cell_guid":"9ae019c9-c140-4175-a122-4da49d26adc9","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"if wandb.run is not None:\n    wandb.finish()\nwandb.init(project=\"tunix-grpo2-demo\", name=f\"GRPO_{NUM_EPOCHS}_epoch_{wandb_name}\")\n\n\n# Find the latest GRPO checkpoint\ncheckpoint_root = \"/tmp/content/grpo2/ckpts/actor/\"\n\nif not os.path.exists(checkpoint_root):\n    print(f\"Directory not found: {checkpoint_root}\")\n    steps = []\nelse:\n    steps = [int(d) for d in os.listdir(checkpoint_root) if d.isdigit()]\n\nif not steps:\n    print(\"No GRPO checkpoints found.\")\nelse:\n    latest_step = max(steps)\n    trained_ckpt_path = os.path.join(checkpoint_root, str(latest_step), \"model_params\")\n    \n    print(f\"✅ Latest GRPO checkpoint found: Step {latest_step}\")\n    print(f\"📂 Path: {trained_ckpt_path}\")\n\n    # Load the trained GRPO weights into the policy model\n    abs_params = jax.tree.map(\n        lambda x: jax.ShapeDtypeStruct(x.shape, x.dtype),\n        nnx.state(lora_policy, nnx.LoRAParam),\n    )\n    checkpointer = ocp.StandardCheckpointer()\n    trained_grpo_params = checkpointer.restore(trained_ckpt_path, target=abs_params)\n\n    nnx.update(lora_policy, trained_grpo_params)\n\n    print(\"✅ Successfully updated lora_policy with final GRPO weights!\")","metadata":{"_uuid":"a907a98e-b5e7-49e3-9116-1b42f5b1fc32","_cell_guid":"6076abdf-81ac-42f2-9945-ad079e8140ce","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Delete it","metadata":{}},{"cell_type":"code","source":"import pandas as pd\nfrom tqdm.auto import tqdm\nimport torch # or jax/numpy depending on context, used here for generic logic\n\n# ================= CONFIGURATION =================\n# How many samples to test?\nNUM_SAMPLES = 50 \n\n# Which dataframe to use?\n# eval_source_df = train_df.sample(n=NUM_SAMPLES, random_state=42).reset_index(drop=True) \neval_source_df = train_df.head(NUM_SAMPLES) # Or just take the first N\n\nOUTPUT_EXCEL_FILE = \"GRPO_Dry_Run_Analysis.xlsx\"\nBATCH_SIZE = 4\n# =================================================\n\n# Ensure sampler is ready (Re-initialize if needed, otherwise skip this block)\nsampler = sampler_lib.Sampler(\n    transformer=lora_policy,\n    tokenizer=tokenizer,\n    cache_config=sampler_lib.CacheConfig(\n        cache_size=MAX_PROMPT_LENGTH + TOTAL_GENERATION_STEPS + 256,\n        num_layers=model_config.num_layers,\n        num_kv_heads=model_config.num_kv_heads,\n        head_dim=model_config.head_dim,\n    ),\n)\n\nprint(f\"🚀 Starting Dry Run on {len(eval_source_df)} samples...\")\n\nresults_list = []\n\n# Iterate in batches\nfor i in tqdm(range(0, len(eval_source_df), BATCH_SIZE), desc=\"Generating & Scoring\"):\n    # 1. Prepare Batch\n    batch_df = eval_source_df.iloc[i : i + BATCH_SIZE]\n    \n    prompts = batch_df['Question'].tolist()\n    answers = batch_df['Answer'].tolist()\n    domains = batch_df['Domain'].tolist()\n    \n    # 2. Generate Responses\n    # Note: generate() usually handles list inputs. \n    # If your generate function expects a string, loop it. \n    # Assuming 'generate' helper from your notebook handles lists:\n    try:\n        model_outputs = generate(prompts, sampler, temperature=0.7) \n        # If generate returns a single string for len=1 list, ensure it's a list\n        if isinstance(model_outputs, str): model_outputs = [model_outputs]\n    except Exception as e:\n        print(f\"Error generating batch {i}: {e}\")\n        continue\n\n    # 3. Calculate Scores & Detailed Breakdown\n    # We call the main reward function to get the \"Training Score\"\n    total_rewards = dispatch_reward(prompts, model_outputs, domains, answers)\n\n    # 4. Detailed Breakdown for Excel (Manual Calculation)\n    # This logic mimics dispatch_reward but saves the pieces\n    for j in range(len(prompts)):\n        p = prompts[j]\n        ans = str(answers[j])\n        dom = str(domains[j]).lower()\n        out = model_outputs[j]\n        final_score = total_rewards[j]\n\n        # Recalculate components specifically for the report\n        format_score = calculate_soft_format_score(out)\n        \n        acc_score = 0.0\n        acc_type = \"N/A\"\n        \n        if \"coding\" in dom:\n            acc_type = \"Coding (Compile+Test)\"\n            acc_score = check_code_quality_robust(out, ans)\n        elif \"math\" in dom:\n            acc_type = \"Math (Match)\"\n            acc_score = check_math_accuracy_robust(out, ans)\n        else:\n            acc_type = \"Unified\"\n            # Approx logic for unified\n            acc_score = max(0.0, final_score - format_score)\n\n        # Append to results\n        results_list.append({\n            \"Domain\": dom,\n            \"Question\": p,\n            \"Ground_Truth\": ans,\n            \"Model_Output\": out,\n            \"Total_Reward\": final_score,\n            \"Format_Score\": format_score,\n            \"Accuracy_Score\": acc_score,\n            \"Accuracy_Type\": acc_type,\n            \"Length\": len(out)\n        })\n\n# ================= EXPORT =================\nprint(\"💾 Saving to Excel...\")\ndf_results = pd.DataFrame(results_list)\n\n# Optional: Color coding or formatting could be done here, \n# but simple export is usually enough.\ndf_results.to_excel(OUTPUT_EXCEL_FILE, index=False)\n\nprint(f\"✅ Done! Download '{OUTPUT_EXCEL_FILE}' to analyze.\")\nprint(df_results[['Domain', 'Total_Reward', 'Format_Score', 'Accuracy_Score']].head())","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Define the path for the final GRPO LoRA checkpoint\nGRPO_LORA_CKPT_DIR = \"/tmp/content/grpo2/lora_final/\"\nos.makedirs(GRPO_LORA_CKPT_DIR, exist_ok=True)\n\n# Extract only the LoRA parameters from the GRPO-trained model\ngrpo_lora_params = nnx.state(lora_policy, nnx.LoRAParam)\n\n# Save the LoRA parameters\ncheckpointer = ocp.PyTreeCheckpointer()\ncheckpointer.save(os.path.join(GRPO_LORA_CKPT_DIR, \"model_params\"), grpo_lora_params)\n\nprint(f\"✅ GRPO LoRA parameters saved to: {GRPO_LORA_CKPT_DIR}\")\n!ls -l {GRPO_LORA_CKPT_DIR}","metadata":{"_uuid":"6171d7c9-e2c2-4333-90cc-0f7cd6c66897","_cell_guid":"57c1ae90-4fa2-473c-8247-97b643f7a25b","trusted":true,"collapsed":false,"jupyter":{"outputs_hidden":false}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"ip = get_ipython